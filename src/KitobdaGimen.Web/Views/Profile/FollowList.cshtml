@using KitobdaGimen.Application.Common.Interfaces
@inject ICurrentUserService CurrentUser
@model PagedResult<FollowUserDto>
@{
    var title = ViewData["Title"] as string ?? "Foydalanuvchilar";
    var targetUserId = ViewData["TargetUserId"] as int?;
    var activeTab = ViewData["ActiveTab"] as string ?? "followers";
    var currentUserId = CurrentUser.UserId;
}

<div class="container page">
    <div class="feed">
        <div class="follow-list-head" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
            <div style="display:flex;align-items:center;gap:10px;">
                <a href="@(targetUserId.HasValue && targetUserId != currentUserId ? $"/profile/{targetUserId}" : "/Feed")" class="btn btn-outline btn-sm" style="padding:7px 12px;">
                    <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>
                    Orqaga
                </a>
                <h1 class="section-title" style="margin:0">@title <span class="muted" style="font-size:16px;font-weight:500;">(@Model.TotalCount)</span></h1>
            </div>

            @if (targetUserId.HasValue)
            {
                <div style="display:inline-flex;background:var(--bg-subtle);border:1px solid var(--border);border-radius:var(--radius-sm);padding:3px;gap:4px;">
                    <a href="/profile/@targetUserId/followers" class="btn btn-sm @(activeTab == "followers" ? "btn-primary" : "btn-ghost")" style="border-radius:7px;padding:6px 14px;">
                        Kuzatuvchilar
                    </a>
                    <a href="/profile/@targetUserId/following" class="btn btn-sm @(activeTab == "following" ? "btn-primary" : "btn-ghost")" style="border-radius:7px;padding:6px 14px;">
                        Kuzatilayotganlar
                    </a>
                </div>
            }
        </div>

        <div class="card">
            @if (Model.Items.Count == 0)
            {
                <div style="text-align:center;padding:32px 16px;">
                    <span class="material-symbols-outlined muted" style="font-size:40px;margin-bottom:8px;">group</span>
                    <p class="muted text-center" style="margin:0;">
                        @(activeTab == "following" ? "Hozircha hech kim kuzatilmayapti." : "Hozircha kuzatuvchilar yo'q.")
                    </p>
                </div>
            }
            else
            {
                foreach (var user in Model.Items)
                {
                    <div class="follow-row">
                        <a href="@KitobdaGimen.Web.ViewHelpers.ProfileUrl(user.Username, user.Id)">
                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                            {
                                <img class="avatar" src="@user.AvatarUrl" alt="@user.FullName" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span class="avatar">@KitobdaGimen.Web.ViewHelpers.Initial(user.FullName)</span>
                            }
                        </a>
                        <div class="info">
                            <a class="name" href="@KitobdaGimen.Web.ViewHelpers.ProfileUrl(user.Username, user.Id)">@user.FullName</a>
                            @if (!string.IsNullOrWhiteSpace(user.Username))
                            {
                                <div class="muted" style="font-size:12.5px">@@@user.Username</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(user.Bio))
                            {
                                <div class="muted" style="font-size:13.5px;margin-top:2px;">@user.Bio</div>
                            }
                        </div>
                        @if (currentUserId != user.Id)
                        {
                            <button class="btn @(user.IsFollowedByCurrentUser ? "btn-outline" : "btn-primary") btn-sm" data-follow="@user.Id">
                                @(user.IsFollowedByCurrentUser ? "Kuzatilmoqda" : "Kuzatish")
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
