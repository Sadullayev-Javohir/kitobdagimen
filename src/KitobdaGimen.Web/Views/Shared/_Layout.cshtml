    @* Kun va Tun rejimi (Light / Dark mode) — FOUC bo'lmasligi uchun <head> ichida darhol o'rnatiladi *@
    <script>
        (function () {
            var STORAGE_KEY = 'kg-theme';
            function getPreferredTheme() {
                try {
                    var saved = localStorage.getItem(STORAGE_KEY);
                    if (saved === 'dark' || saved === 'light') return saved;
                } catch (_) { }
                return 'light';
            }
            function applyTheme(theme) {
                var t = theme === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.classList.toggle('dark', t === 'dark');
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', t === 'dark' ? '#090D16' : '#FFFFFF');
            }
            var initialTheme = getPreferredTheme();
            applyTheme(initialTheme);
            window.kgTheme = {
                get: function () {
                    return document.documentElement.getAttribute('data-theme') || 'light';
                },
                set: function (theme) {
                    var t = theme === 'dark' ? 'dark' : 'light';
                    try { localStorage.setItem(STORAGE_KEY, t); } catch (_) { }
                    applyTheme(t);
                    document.querySelectorAll('[data-theme-toggle] .theme-icon').forEach(function (ic) {
                        ic.textContent = t === 'dark' ? 'light_mode' : 'dark_mode';
                    });
                },
                toggle: function () {
                    var next = this.get() === 'dark' ? 'light' : 'dark';
                    this.set(next);
                    return next;
                }
            };
        })();
    </script>

    @* Rasm xatolarini global hal qilish *@
    <script>
        (function () {
            function onImgError(e) {
                var img = e.target;
                if (!img || img.tagName !== 'IMG') return;
                if (img.id === 'chatLightboxImg' || (img.closest && img.closest('.chat-lightbox'))) return;
                if (!img.dataset.imgRetry) {
                    img.dataset.imgRetry = '1';
                    try { img.referrerPolicy = 'no-referrer'; } catch (_) { }
                    var s = img.src; img.src = ''; img.src = s;
                    return;
                }
                if (img.dataset.imgFailed) return;
                img.dataset.imgFailed = '1';
                if (img.classList.contains('avatar')) {
                    var name = (img.getAttribute('alt') || '?').trim();
                    var span = document.createElement('span');
                    span.className = img.className;
                    span.textContent = name ? name.charAt(0).toUpperCase() : '?';
                    if (img.parentNode) img.parentNode.replaceChild(span, img);
                } else if (img.closest) {
                    var wrap = img.closest('[class*="cover"]');
                    if (wrap) { wrap.innerHTML = '<span class="material-symbols-outlined">menu_book</span>'; }
                    else { img.style.visibility = 'hidden'; }
                }
            }
            document.addEventListener('error', onImgError, true);
        })();
    </script>

