                </div>

                <div class="composer-image-picker" style="margin-top:12px">
                    <input type="hidden" id="storyImageUrl" />
                    <div id="storyImgPreview" class="composer-image-preview" hidden>
                        <img id="storyImgPreviewImg" src="" alt="Tanlangan rasm" />
                        <button type="button" class="composer-image-remove" id="storyImgClear" aria-label="Rasmni o'chirish">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <label class="btn btn-outline btn-sm" for="storyImageInput">
                        <span class="material-symbols-outlined ic-sm ic-baseline">image</span>
                        Rasm qo'shish (ixtiyoriy)
                    </label>
                    <input type="file" id="storyImageInput" accept="image/*" hidden />
                </div>

                <div style="margin-top:14px">
                    <label>Story qancha vaqt ko'rinsin?</label>
                    <div class="story-duration" id="storyDuration" role="radiogroup">
                        <button type="button" class="story-duration-opt" data-duration="12">12 soat</button>
                        <button type="button" class="story-duration-opt is-active" data-duration="24">24 soat</button>
                        <button type="button" class="story-duration-opt" data-duration="48">48 soat</button>
                    </div>
                </div>

                <p class="username-status" id="storyComposerError" data-state="bad" hidden></p>

                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" data-story-composer-cancel>Bekor qilish</button>
                    <button type="button" class="btn btn-primary" id="storyComposerSubmit" disabled>Joylash</button>
                </div>
            </div>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    }

    <script>
        (function () {
            function syncThemeIcons() {
                if (!window.kgTheme) return;
                var cur = window.kgTheme.get();
                document.querySelectorAll('[data-theme-toggle] .theme-icon').forEach(function (ic) {
                    ic.textContent = cur === 'dark' ? 'light_mode' : 'dark_mode';
                });
            }
            syncThemeIcons();
            document.addEventListener('click', function (e) {
                var btn = e.target.closest && e.target.closest('[data-theme-toggle]');
                if (!btn || !window.kgTheme) return;
                e.preventDefault();
                window.kgTheme.toggle();
            });

            // Telegram Mini App (WebApp) integratsiyasi: avtomatik expand, tema moslashtirish va parolsiz kirish
            if (window.Telegram && window.Telegram.WebApp) {
                var tgApp = window.Telegram.WebApp;
                try {
                    tgApp.ready();
                    tgApp.expand();
                    document.documentElement.classList.add('is-tg-webapp');
                    if (tgApp.colorScheme === 'dark' && !localStorage.getItem('kg-theme') && window.kgTheme) {
                        window.kgTheme.set('dark');
                    }
                } catch (_) { }

                var isUserLoggedIn = @(isAuth ? "true" : "false");
                var startParam = (tgApp.initDataUnsafe && tgApp.initDataUnsafe.start_param) || '';
                var targetProfileSlug = (startParam.indexOf('profile_') === 0)
                    ? startParam.substring('profile_'.length).trim()
                    : null;

                if (!isUserLoggedIn && tgApp.initData && tgApp.initData.length > 10 && !sessionStorage.getItem('kg_tg_autologin_tried')) {
                    sessionStorage.setItem('kg_tg_autologin_tried', '1');
                    var formBody = new URLSearchParams();
                    formBody.set('initData', tgApp.initData);
                    fetch('/auth/telegram-webapp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                        body: formBody.toString()
                    })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (res) {
                        if (res && res.ok) {
                            if (targetProfileSlug) {
                                window.location.href = '/profile/' + encodeURIComponent(targetProfileSlug);
                            } else {
                                window.location.href = res.redirectUrl || res.redirect || '/Feed';
                            }
                        }
                    })
                    .catch(function () { });
                } else if (targetProfileSlug) {
                    var targetPath = '/profile/' + encodeURIComponent(targetProfileSlug).toLowerCase();
                    var currentPath = window.location.pathname.toLowerCase();
                    if (currentPath !== targetPath && !sessionStorage.getItem('kg_tg_sp_' + targetProfileSlug)) {
                        sessionStorage.setItem('kg_tg_sp_' + targetProfileSlug, '1');
                        window.location.href = '/profile/' + encodeURIComponent(targetProfileSlug);
                    }
                }
            }
        })();
    </script>
    <partial name="_LikesModal" />
    @if (!isAuth)
    {
        <partial name="_AuthPromptModal" />
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () { /* jim: ixtiyoriy */ });
            });
        }
    </script>
    @if (isAuth)
    {
        <script src="~/js/push.js" asp-append-version="true"></script>
        <script src="~/js/year-review-scene.js" asp-append-version="true"></script>
        <script src="~/js/year-review.js" asp-append-version="true"></script>
    }
</body>
</html>
