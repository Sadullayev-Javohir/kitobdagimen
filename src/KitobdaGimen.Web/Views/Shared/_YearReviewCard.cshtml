@using KitobdaGimen.Application.Features.YearReview.Dtos
@model YearReviewDto
@{
    var shareUrl = ViewData["ShareUrl"] as string ?? "";
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? "Kitobxon" : Model.FullName.Trim();
    var initial = displayName[..1].ToUpper();

    var avgPerDay = Model.ActiveDays > 0 ? (int)System.Math.Round((double)Model.TotalPages / Model.ActiveDays) : 0;
    var maxBookPages = Model.Books.Count > 0 ? System.Math.Max(1, Model.Books.Max(b => b.Pages)) : 1;

    string readerTitle = Model.TotalPages switch
    {
        >= 5000 => "Mutolaa Ustasi",
        >= 2500 => "Katta Kitobxon",
        >= 1000 => "Zukko Kitobxon",
        >= 300  => "Faol Mutolaachi",
        _       => "Yangi Kitobxon"
    };

    // ── KitobdaGimen rasmiy logotipi (Boyo'g'li) inline SVG ──
    string LogoSvg(int size) =>
        $"<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" width=\"{size}\" height=\"{size}\">" +
        "<g transform=\"translate(8,4)\">" +
        "<ellipse cx=\"42\" cy=\"58\" rx=\"33\" ry=\"41\" fill=\"#E8703A\"/>" +
        "<path d=\"M 9 39 Q 2 16 22 19 Q 14 31 16 45 Z\" fill=\"#E8703A\"/>" +
        "<path d=\"M 75 39 Q 82 16 62 19 Q 70 31 68 45 Z\" fill=\"#E8703A\"/>" +
        "<circle cx=\"28\" cy=\"46\" r=\"12\" fill=\"#FAF6EE\"/>" +
        "<circle cx=\"56\" cy=\"46\" r=\"12\" fill=\"#FAF6EE\"/>" +
        "<circle cx=\"28\" cy=\"46\" r=\"6.4\" fill=\"#1B4D3E\"/>" +
        "<circle cx=\"56\" cy=\"46\" r=\"6.4\" fill=\"#1B4D3E\"/>" +
        "<path d=\"M 42 52.5 L 37 62.5 L 47 62.5 Z\" fill=\"#d2602d\"/>" +
        "<path d=\"M 6 76 Q 1 85 8 91 Q 12 84 12.5 76 Z\" fill=\"#d2602d\"/>" +
        "<path d=\"M 78 76 Q 83 85 76 91 Q 72 84 71.5 76 Z\" fill=\"#d2602d\"/>" +
        "<g transform=\"translate(15.5,74)\">" +
        "<path d=\"M 0 4.8 Q 0 0 4.8 0 L 22.5 0 Q 25.5 0 25.5 3.2 L 25.5 30.5 Q 25.5 33.7 22.5 33.7 L 4.8 33.7 Q 0 33.7 0 28.9 Z\" fill=\"#1B4D3E\"/>" +
        "<path d=\"M 51 4.8 Q 51 0 46.2 0 L 28.5 0 Q 25.5 0 25.5 3.2 L 25.5 30.5 Q 25.5 33.7 28.5 33.7 L 46.2 33.7 Q 51 33.7 51 28.9 Z\" fill=\"#1B4D3E\"/>" +
        "<line x1=\"25.5\" y1=\"3.2\" x2=\"25.5\" y2=\"32\" stroke=\"#FAF6EE\" stroke-width=\"1.2\"/>" +
        "</g>" +
        "<ellipse cx=\"29.5\" cy=\"100\" rx=\"5.2\" ry=\"2.6\" fill=\"#d2602d\"/>" +
        "<ellipse cx=\"54.5\" cy=\"100\" rx=\"5.2\" ry=\"2.6\" fill=\"#d2602d\"/>" +
        "</g></svg>";

    var iconPaths = new Dictionary<string, string>
    {
        ["book"] = "<path d=\"M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783\"/>",
        ["fire"] = "<path d=\"M8 16c3.314 0 6-2 6-5.5 0-1.5-.5-4-2.5-6 .25 1.5-1.25 2-1.25 2C11 4 9 .5 6 0c.357 2 .5 4-2 6-1.25 1-2 2.729-2 4.5C2 14 4.686 16 8 16m0-1c-1.657 0-3-1-3-2.75 0-.75.25-2 1.25-3C6.125 10 7 10.5 7 10.5c-.375-1.25.5-3.25 2-3.5-.179 1-.25 2 1 3 .625.5 1 1.364 1 2.25C11 14 9.657 15 8 15\"/>",
        ["lightning"] = "<path d=\"M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z\"/>",
        ["sparkle"] = "<path d=\"M7.657 6.247c.11-.33.576-.33.686 0l.645 1.937a2.89 2.89 0 0 0 1.829 1.828l1.936.645c.33.11.33.576 0 .686l-1.937.645a2.89 2.89 0 0 0-1.828 1.829l-.645 1.936a.361.361 0 0 1-.686 0l-.645-1.937a2.89 2.89 0 0 0-1.828-1.828l-1.937-.645a.361.361 0 0 1 0-.686l1.937-.645a2.89 2.89 0 0 0 1.828-1.828zM3.794 1.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387A1.73 1.73 0 0 0 4.593 5.69l-.387 1.162a.217.217 0 0 1-.412 0L3.407 5.69A1.73 1.73 0 0 0 2.31 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387A1.73 1.73 0 0 0 3.407 2.31z\"/>",
        ["heart"] = "<path fill-rule=\"evenodd\" d=\"M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314\"/>",
        ["quote"] = "<path d=\"M12 12a1 1 0 0 0 1-1V8.558a1 1 0 0 0-1-1h-1.388c0-.351.021-.503.227-1.143.123-.38.351-.732.673-1.026a.5.5 0 0 0-.342-.87A3.7 3.7 0 0 0 8.5 7.558V11a1 1 0 0 0 1 1zm-7 0a1 1 0 0 0 1-1V8.558a1 1 0 0 0-1-1H3.612c0-.351.021-.503.227-1.143.123-.38.351-.732.673-1.026a.5.5 0 0 0-.342-.87A3.7 3.7 0 0 0 1.5 7.558V11a1 1 0 0 0 1 1z\"/>",
        ["award"] = "<path d=\"m8 0 1.669.864 1.858.282.842 1.68 1.337 1.32L13.4 6l.306 1.854-1.337 1.32-.842 1.68-1.858.282L8 12l-1.669-.864-1.858-.282-.842-1.68-1.337-1.32L2.6 6l-.306-1.854 1.337-1.32.842-1.68 1.858-.282z\"/><path d=\"M4 11.794V16l4-1 4 1v-4.206l-2.018.306L8 13.126 6.018 12.1z\"/>"
    };

    string Icon(string name, string? cls = null)
    {
        var path = iconPaths.TryGetValue(name, out var p) ? p : "";
        var extra = string.IsNullOrEmpty(cls) ? "" : $" {cls}";
        return $"<svg class=\"yr-ic{extra}\" viewBox=\"0 0 16 16\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">{path}</svg>";
    }
}

<div class="yr-card yr-theme-@Model.ThemeVariant"
     data-yr-year="@Model.Year"
     data-yr-share-url="@shareUrl"
     data-yr-name="@displayName">

    @* ── STAGE (Konteyner: ekran o'lchamiga qarab transform: scale bilan sig'diriladi) ── *@
    <div class="yr-stage" data-yr-stage>

        @* ── POSTER (html2canvas tortib oladigan 1080px to'liq kanvas) ── *@
        <div class="yr-poster" data-yr-capture>

            @* ── Fon: Atmosferik gradient va nurlar (To'liq CSS/SVG) ── *@
            <div class="yr-canvas-bg" aria-hidden="true">
                <div class="yr-aurora yr-aurora-primary"></div>
                <div class="yr-aurora yr-aurora-accent"></div>
                <div class="yr-grid-mesh"></div>
                <div class="yr-stars-dust">
                    @for (var i = 0; i < 30; i++)
                    {
                        <span class="yr-star-particle yr-sp-@(i % 5)"></span>
                    }
                </div>
            </div>

            <div class="yr-poster-content">

                @* ── 1. Brand Header ── *@
                <header class="yr-brand-row">
                    <div class="yr-brand-lockup">
                        <span class="yr-brand-owl">@Html.Raw(LogoSvg(44))</span>
                        <div class="yr-brand-text">
                            <span class="yr-brand-name">kitobdagimen<span class="yr-brand-ext">.uz</span></span>
                            <span class="yr-brand-tag">Kitobxonlar hamjamiyati</span>
                        </div>
                    </div>
                    <div class="yr-year-badge">
                        <span class="yr-badge-spark">@Html.Raw(Icon("sparkle"))</span>
                        <span>@Model.Year YILLIK HISOBOT</span>
                    </div>
                </header>

                @* ── 2. Reader Identity ── *@
                <div class="yr-reader-row">
                    <div class="yr-avatar-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                        {
                            <img class="yr-avatar-img" src="@Model.AvatarUrl" alt="@displayName" crossorigin="anonymous" />
                        }
                        else
                        {
                            <div class="yr-avatar-monogram">@initial</div>
                        }
                        <span class="yr-avatar-badge">@Html.Raw(Icon("award"))</span>
                    </div>
                    <div class="yr-reader-meta">
                        <div class="yr-reader-rank">
                            <span class="yr-rank-dot"></span>
                            <span>@readerTitle</span>
                        </div>
                        <h2 class="yr-reader-name">@displayName</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.Username))
                        {
                            <span class="yr-reader-handle">@@@Model.Username</span>
                        }
                    </div>
                </div>

                @if (Model.HasActivity)
                {
                    @* ── 3. Grand Hero Metric ── *@
                    <section class="yr-hero-metric">
                        <div class="yr-hero-glow"></div>
                        <div class="yr-hero-overline">YIL BO'YICHA JAMI MUTOLAA</div>
                        <div class="yr-hero-number-wrap">
                            <span class="yr-hero-number">@Model.TotalPages.ToString("N0").Replace(",", " ")</span>
                            <span class="yr-hero-unit">sahifa</span>
                        </div>
                        <p class="yr-hero-desc">
                            Yil davomida o'qilgan sahifalar, chuqur fikrlar va yangi kashfiyotlar sarhisobi.
                        </p>
                    </section>

                    @* ── 4. Bento Stats Grid (3 ta asosiy kartochka) ── *@
                    <section class="yr-bento-grid">
                        <div class="yr-bento-card">
                            <div class="yr-bento-head">
                                <span class="yr-bento-ic yr-bento-ic-emerald">@Html.Raw(Icon("book"))</span>
                                <span class="yr-bento-label">KITOBLAR</span>
                            </div>
                            <div class="yr-bento-value">@Model.BooksRead</div>
                            <div class="yr-bento-sub">ta asar mutolaa qilindi</div>
                        </div>

                        <div class="yr-bento-card">
                            <div class="yr-bento-head">
                                <span class="yr-bento-ic yr-bento-ic-orange">@Html.Raw(Icon("fire"))</span>
                                <span class="yr-bento-label">FAOL KUNLAR</span>
                            </div>
                            <div class="yr-bento-value">@Model.ActiveDays</div>
                            <div class="yr-bento-sub">kun kitob bilan birga</div>
                        </div>

                        <div class="yr-bento-card">
                            <div class="yr-bento-head">
                                <span class="yr-bento-ic yr-bento-ic-amber">@Html.Raw(Icon("lightning"))</span>
                                <span class="yr-bento-label">KUNLIK O'RTACHA</span>
                            </div>
                            <div class="yr-bento-value">@avgPerDay</div>
                            <div class="yr-bento-sub">sahifa har faol kunda</div>
                        </div>
                    </section>

                    @* ── 5. O'qilgan Kitoblar Ro'yxati ── *@
                    <section class="yr-card-section">
                        <div class="yr-section-header">
                            <div class="yr-section-title">
                                <span class="yr-title-icon">@Html.Raw(Icon("book"))</span>
                                <span>Mutolaa qilingan kitoblar</span>
                            </div>
                            @if (Model.Books.Count > 0)
                            {
                                <span class="yr-count-pill">@Model.Books.Count ta kitob</span>
                            }
                        </div>

                        @if (Model.Books.Count > 0)
                        {
                            <div class="yr-books-list">
                                @{ var rank = 0; }
                                @foreach (var book in Model.Books)
                                {
                                    rank++;
                                    var pct = (int)System.Math.Round(100.0 * book.Pages / maxBookPages);
                                    <div class="yr-book-item">
                                        <div class="yr-book-rank">@(rank < 10 ? $"0{rank}" : rank.ToString())</div>
                                        <div class="yr-book-body">
                                            <div class="yr-book-row-top">
                                                <div class="yr-book-info">
                                                    <span class="yr-book-title">@book.Title</span>
                                                    @if (!string.IsNullOrWhiteSpace(book.Author))
                                                    {
                                                        <span class="yr-book-author">@book.Author</span>
                                                    }
                                                </div>
                                                <div class="yr-book-pages-badge">
                                                    <span class="yr-pages-val">@book.Pages</span>
                                                    <span class="yr-pages-lbl">bet</span>
                                                </div>
                                            </div>
                                            <div class="yr-progress-track">
                                                <div class="yr-progress-bar" style="width: @pct%"></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="yr-empty-state">
                                <span>Bu yil kitob javoningizga yangi asarlar qo'shilish arafasida.</span>
                            </div>
                        }
                    </section>

                    @* ── 6. Yilning Eng Sara Qaydlari (Post & Iqtibos) ── *@
                    @if (Model.TopPost is not null || Model.TopQuote is not null)
                    {
                        <section class="yr-card-section">
                            <div class="yr-section-header">
                                <div class="yr-section-title">
                                    <span class="yr-title-icon">@Html.Raw(Icon("sparkle"))</span>
                                    <span>Yilning eng sara yozuvlari</span>
                                </div>
                            </div>

                            <div class="yr-highlights-grid">
                                @if (Model.TopPost is not null)
                                {
                                    <div class="yr-highlight-card">
                                        <div class="yr-hl-top">
                                            <span class="yr-hl-tag yr-hl-tag-post">Eng ommabop taqriz</span>
                                            <span class="yr-hl-likes">@Html.Raw(Icon("heart")) @Model.TopPost.LikeCount</span>
                                        </div>
                                        <p class="yr-hl-text">“@Model.TopPost.Snippet”</p>
                                        <div class="yr-hl-source">
                                            <span class="yr-hl-book">@Model.TopPost.BookTitle</span>
                                        </div>
                                    </div>
                                }

                                @if (Model.TopQuote is not null)
                                {
                                    <div class="yr-highlight-card">
                                        <div class="yr-hl-top">
                                            <span class="yr-hl-tag yr-hl-tag-quote">Eng sevimli iqtibos</span>
                                            <span class="yr-hl-likes">@Html.Raw(Icon("heart")) @Model.TopQuote.LikeCount</span>
                                        </div>
                                        <p class="yr-hl-text">“@Model.TopQuote.Snippet”</p>
                                        <div class="yr-hl-source">
                                            <span class="yr-hl-book">@Model.TopQuote.BookTitle</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
                else
                {
                    @* ── Bo'sh holat ── *@
                    <section class="yr-empty-hero">
                        <div class="yr-empty-icon">@Html.Raw(Icon("book"))</div>
                        <h3 class="yr-empty-title">Mutolaa sari yangi qadam</h3>
                        <p class="yr-empty-text">
                            Bu yil kitoblar olamiga ilk qadamlaringizni qo'ydingiz. Kelasi @(Model.Year + 1)-yil yakuni
                            yangi asarlar, taassurotlar va boy bilimlar bilan to'lib-toshsin!
                        </p>
                    </section>
                }

                @* ── 7. Personalized Motivation / Epilogue ── *@
                <section class="yr-motivation-box">
                    <span class="yr-quote-sign">“</span>
                    <div class="yr-motivation-content">
                        <span class="yr-motivation-label">YILLIK XULOSA</span>
                        <p class="yr-motivation-text">@Model.Motivation</p>
                    </div>
                </section>

                @* ── 8. Card Footer Brand Lockup ── *@
                <footer class="yr-card-footer">
                    <div class="yr-foot-left">
                        <span class="yr-foot-owl">@Html.Raw(LogoSvg(26))</span>
                        <span class="yr-foot-name">kitobdagimen<span class="yr-foot-ext">.uz</span></span>
                    </div>
                    <div class="yr-foot-divider"></div>
                    <div class="yr-foot-motto">Mutolaa madaniyati va kitobxonlar tarmog'i</div>
                    <div class="yr-foot-divider"></div>
                    <div class="yr-foot-edition">@Model.Year Yakuni</div>
                </footer>

            </div>@* /.yr-poster-content *@
        </div>@* /.yr-poster *@

    </div>@* /.yr-stage *@

    @* ── 9. Yuklab olish amallari — FAQAT PNG va JPG ── *@
    <div class="yr-actions" data-yr-actions>
        <button type="button" class="yr-btn yr-btn-primary" data-yr-download="png" title="Eng yuqori tiniqlikdagi HD PNG tasvir">
            <svg class="yr-btn-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="yr-btn-text">PNG formatda yuklab olish</span>
            <span class="yr-btn-badge">HD 1080p</span>
        </button>

        <button type="button" class="yr-btn yr-btn-secondary" data-yr-download="jpg" title="Ixcham va sifatli JPG tasvir">
            <svg class="yr-btn-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span class="yr-btn-text">JPG formatda yuklab olish</span>
        </button>
    </div>
</div>
