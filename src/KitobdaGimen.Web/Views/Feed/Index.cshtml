@using KitobdaGimen.Application.Common.Interfaces
@using KitobdaGimen.Application.Features.Auth.Queries.GetCurrentUser
@using KitobdaGimen.Web.Models
@using MediatR
@inject ISender Mediator
@inject ITelegramBotService TelegramBotService
@model FeedPageViewModel
@{
    ViewData["Title"] = "Asosiy";
    var me = Model.CurrentUser;
    var meInitial = KitobdaGimen.Web.ViewHelpers.Initial(me?.FullName);
    ViewData["ShowAuthorActions"] = true;
    var search = Model.Search ?? "";
}

<div class="feed-page-wrap">
    <div class="feed-layout">
        <!-- Chap panel / Left Sidebar: Yangilangan profil kartochkasi va Shaxsiy bo'limlar -->
        <aside class="feed-sidebar feed-sidebar-left">
            @if (me != null)
            {
                <div class="feed-profile-card">
                    <div class="feed-profile-head">
                        <a class="feed-profile-avatar-wrap" href="/profile">
                            @if (!string.IsNullOrEmpty(me?.AvatarUrl))
                            {
                                <img class="feed-profile-avatar" src="@me.AvatarUrl" alt="@me.FullName" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span class="feed-profile-avatar">@meInitial</span>
                            }
                            <span class="feed-profile-status-dot" title="Faol kitobxon"></span>
                        </a>
                        <div class="feed-profile-identity">
                            <a class="feed-profile-name" href="/profile">
                                @(me?.FullName ?? "Kitobxon")
                                @Html.Raw(KitobdaGimen.Web.ViewHelpers.FounderBadge(me?.Username))
                            </a>
                            @if (!string.IsNullOrEmpty(me?.Username))
                            {
                                <span class="feed-profile-handle">@@@me.Username</span>
                            }
                            else
                            {
                                <span class="feed-profile-handle">Kitobxon</span>
                            }
                        </div>
                        <a href="/profile/edit" class="feed-profile-edit-btn" title="Profilni tahrirlash" aria-label="Profilni tahrirlash">
                            <span class="material-symbols-outlined">edit_square</span>
                        </a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.UserProfile?.Bio))
                    {
                        <p class="feed-profile-bio">@Model.UserProfile.Bio</p>
                    }

                    <div class="feed-profile-stats">
                        <a href="/profile" class="feed-profile-stat">
                            <span class="feed-profile-stat-val">@(Model.UserProfile?.PostCount ?? 0)</span>
                            <span class="feed-profile-stat-lbl">Taqrizlar</span>
                        </a>
                        <a href="@(me != null ? $"/profile/{me.Id}/followers" : "/profile/followers")" class="feed-profile-stat">
                            <span class="feed-profile-stat-val">@(Model.UserProfile?.FollowerCount ?? 0)</span>
                            <span class="feed-profile-stat-lbl">Kuzatuvchilar</span>
                        </a>
                        <a href="@(me != null ? $"/profile/{me.Id}/following" : "/profile/following")" class="feed-profile-stat">
                            <span class="feed-profile-stat-val">@(Model.UserProfile?.FollowingCount ?? 0)</span>
                            <span class="feed-profile-stat-lbl">Kuzatilayotganlar</span>
                        </a>
                    </div>

                    @if (Model.ActiveGoal != null)
                    {
                        var goalCover = !string.IsNullOrEmpty(Model.ActiveGoal.Book.CoverUrl)
                            ? Model.ActiveGoal.Book.CoverUrl
                            : "/img/default-book-cover.webp";
                        <a href="/reading-books/@Model.ActiveGoal.Id" class="feed-profile-goal">
                            <div class="feed-profile-goal-top">
                                <span class="feed-profile-goal-badge">
                                    <span class="material-symbols-outlined">local_fire_department</span>
                                    Mutolaada
                                </span>
                                <span class="feed-profile-goal-pct">@(Model.ActiveGoal.ProgressPercent)%</span>
                            </div>
                            <div class="feed-profile-goal-book-row">
                                <img class="feed-profile-goal-cover" src="@goalCover" alt="@Model.ActiveGoal.Book.Title" />
                                <div class="feed-profile-goal-info">
                                    <span class="feed-profile-goal-title" title="@Model.ActiveGoal.Book.Title">@Model.ActiveGoal.Book.Title</span>
                                    <span class="feed-profile-goal-pages">@Model.ActiveGoal.CurrentPage / @Model.ActiveGoal.TotalPages bet · Bugun: <strong>@Model.ActiveGoal.PagesReadToday</strong></span>
                                </div>
                            </div>
                            <div class="feed-profile-goal-track">
                                <div class="feed-profile-goal-fill" style="width: @(Model.ActiveGoal.ProgressPercent)%"></div>
                            </div>
                        </a>
                    }
                    else
                    {
                        <a href="/reading-books" class="feed-profile-goal-empty">
                            <span class="material-symbols-outlined">add_circle</span>
                            <span>Mutolaa uchun kitob tanlash</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="feed-profile-card feed-guest-card">
                    <div class="feed-guest-head">
                        <div class="feed-guest-logo-wrap">
                            <img class="feed-guest-logo" src="/img/logo.png" alt="KitobdagiMen" />
                        </div>
                        <h3 class="feed-guest-title">KitobdagiMen<span class="brand-dot">.uz</span></h3>
                        <p class="feed-guest-sub muted">Kitobxonlar ijtimoiy platformasi</p>
                    </div>
                    <p class="feed-guest-desc">
                        Kitoblar haqida fikr bildiring, iqtiboslarni saqlang va kitobsevarlar bilan do'stlashing!
                    </p>
                    <div class="feed-guest-actions">
                        <a href="/login" class="btn btn-primary btn-block feed-guest-btn-login">
                            <span class="material-symbols-outlined ic-sm">login</span>
                            <span>Tizimga kirish</span>
                        </a>
                        <a href="https://t.me/@(TelegramBotService.BotUsername)?start=web" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-block feed-guest-btn-tg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                            </svg>
                            <span>Ro'yxatdan o'tish</span>
                        </a>
                    </div>
                </div>
            }

            <!-- Kun iqtibosi yoki Kun taqrizi (Daily Jackpot kartasi) -->
            @if (Model.DailyJackpot != null)
            {
                var dj = Model.DailyJackpot;
                var djInitial = KitobdaGimen.Web.ViewHelpers.Initial(dj.UserFullName);
                var djCover = !string.IsNullOrWhiteSpace(dj.BookCoverUrl) ? dj.BookCoverUrl : "/img/default-book-cover.webp";
                var djIsPost = dj.Type == "post";
                var djTitle = djIsPost ? "Kun taqrizi" : "Kun iqtibosi";

                <a href="/jackpot" class="feed-jackpot-card" title="Kunlik Jackpot sahifasiga o'tish">
                    <div class="feed-jackpot-badge-row">
                        <span class="feed-jackpot-pill">
                            <span class="material-symbols-outlined">@(djIsPost ? "rate_review" : "format_quote")</span>
                            @djTitle
                        </span>
                        <span class="feed-jackpot-tag">
                            <span>🎰 Jackpot</span>
                        </span>
                    </div>

                    <div class="feed-jackpot-author">
                        <div class="feed-jackpot-avatar-wrap">
                            @if (!string.IsNullOrWhiteSpace(dj.UserAvatarUrl))
                            {
                                <img class="feed-jackpot-avatar" src="@dj.UserAvatarUrl" alt="@dj.UserFullName" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span class="feed-jackpot-avatar">@djInitial</span>
                            }
                            <span class="feed-jackpot-crown-mini" title="Bugungi Kun Qahramoni">👑</span>
                        </div>
                        <div class="feed-jackpot-author-meta">
                            <span class="feed-jackpot-author-name">@dj.UserFullName</span>
                            <span class="feed-jackpot-author-sub">
                                <span class="material-symbols-outlined" style="font-size: 13px;">military_tech</span>
                                Kun Qahramoni
                            </span>
                        </div>
                    </div>

                    <div class="feed-jackpot-book">
                        <img class="feed-jackpot-book-cover" src="@djCover" alt="@dj.BookTitle" />
                        <div class="feed-jackpot-book-info">
                            <span class="feed-jackpot-book-title" title="@dj.BookTitle">@dj.BookTitle</span>
                            @if (!string.IsNullOrWhiteSpace(dj.BookAuthor))
                            {
                                <span class="feed-jackpot-book-author">@dj.BookAuthor</span>
                            }
                        </div>
                    </div>

                    <div class="feed-jackpot-body">
                        <p class="feed-jackpot-text">@KitobdaGimen.Application.Common.RichTextSanitizer.StripHtml(dj.Content)</p>
                    </div>

                    <div class="feed-jackpot-footer">
                        <div class="feed-jackpot-stats">
                            <span><span class="material-symbols-outlined" style="font-size: 14px; color: #ef4444;">favorite</span> @dj.LikeCount</span>
                            <span><span class="material-symbols-outlined" style="font-size: 14px; color: #3b82f6;">chat_bubble</span> @dj.CommentCount</span>
                        </div>
                        <span class="feed-jackpot-cta">
                            Jackpot zali
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </span>
                    </div>
                </a>
            }

            <!-- Shaxsiy bo'limlar -->
            <div class="feed-quick-card">
                <nav class="feed-quick-nav" aria-label="Shaxsiy bo'limlar">
                    <a href="/kitoblar" class="feed-quick-item">
                        <span class="feed-quick-icon is-blue">
                            <span class="material-symbols-outlined">library_books</span>
                        </span>
                        <span class="feed-quick-text">
                            <strong>Kitoblar katalogi</strong>
                            <small>Asarlar va taqrizlar bazasi</small>
                        </span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Asosiy o'rta ustun / Main Feed -->
        <main class="feed-main">
            <div class="feed">
                <!-- Qidiruv paneli -->
                <div class="feed-search-card">
                    <form method="get" action="/Feed" id="feedSearchForm" class="feed-search-form">
                        <div class="search-box">
                            <span class="search-ico material-symbols-outlined">search</span>
                            <input class="input" type="search" name="q" id="feedSearchInput"
                                   placeholder="Taqriz matni, kitob, muallif yoki iqtibos bo'yicha qidiring..."
                                   value="@search" autocomplete="off" />
                        </div>
                    </form>
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <a class="btn btn-outline btn-sm" href="/Feed" id="feedSearchClear" title="Qidiruvni tozalash">
                            <span class="material-symbols-outlined ic-sm ic-baseline">close</span>
                            Tozalash
                        </a>
                    }
                </div>

                @if (!string.IsNullOrEmpty(search))
                {
                    <div class="muted" style="margin-bottom:8px; font-size:14px">
                        <strong>"@search"</strong> bo'yicha qidiruv natijalari —
                        <a href="/Feed">barcha taqrizlarga qaytish</a>
                    </div>
                }

                <!-- Taqriz yaratish — qidiruvda yashiriladi, qidiruv tugagach qaytadi -->
                @if (string.IsNullOrEmpty(search))
                {
                <!-- Yopiq holatdagi tugma (bosilganda modal ochiladi) -->
                <button type="button" class="card composer-trigger" id="composerTrigger">
                    @if (!string.IsNullOrEmpty(me?.AvatarUrl))
                    {
                        <img class="avatar" src="@me!.AvatarUrl" alt="@me.FullName" referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <span class="avatar">@meInitial</span>
                    }
                    <span class="composer-trigger-text">Qaysi kitob haqida fikr bildirasiz?</span>
                    <div class="composer-trigger-actions">
                        <span class="composer-trigger-pill">
                            <span class="material-symbols-outlined">article</span>
                            Taqriz
                        </span>
                        <span class="composer-trigger-pill">
                            <span class="material-symbols-outlined">format_quote</span>
                            Iqtibos
                        </span>
                    </div>
                    <span class="material-symbols-outlined composer-trigger-mobile-ico">edit_square</span>
                </button>

        <!-- Taqriz yoki iqtibos tanlash modali — kompozer tugmasi bosilganda birinchi shu ochiladi -->
        <div class="composer-modal" id="typeChoiceModal" hidden>
            <div class="composer-modal-backdrop" data-type-choice-close></div>
            <div class="composer-modal-box composer-choice-box card" role="dialog" aria-modal="true" aria-label="Taqriz yoki iqtibos">
                <div class="composer-modal-head">
                    <h3>Qaysi kitob haqida fikr bildirasiz?</h3>
                    <button type="button" class="composer-close" data-type-choice-close aria-label="Yopish">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="composer-choice-grid">
                    <button type="button" class="composer-choice-item is-primary" id="chooseTaqriz">
                        <span class="composer-choice-icon">
                            <span class="material-symbols-outlined">article</span>
                        </span>
                        <span class="composer-choice-text">
                            <strong>Taqriz yozish</strong>
                            <small>Asar haqida batafsil fikr va tahlil</small>
                        </span>
                        <span class="material-symbols-outlined composer-choice-arrow">chevron_right</span>
                    </button>
                    <button type="button" class="composer-choice-item is-accent" id="chooseIqtibos">
                        <span class="composer-choice-icon">
                            <span class="material-symbols-outlined">format_quote</span>
                        </span>
                        <span class="composer-choice-text">
                            <strong>Iqtibos ulashish</strong>
                            <small>Kitobdan ta'sirli jumla yoki satr</small>
                        </span>
                        <span class="material-symbols-outlined composer-choice-arrow">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Taqriz modali -->
        <div class="composer-modal" id="composerModal" hidden>
            <div class="composer-modal-backdrop" data-composer-close></div>
            <div class="composer-modal-box card" role="dialog" aria-modal="true" aria-label="Yangi taqriz">
                <div class="composer-modal-head">
                    <h3>Qaysi kitob haqida fikr bildirasiz?</h3>
                    <button type="button" class="composer-close" data-composer-close aria-label="Yopish">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

            <form id="postForm" method="post" action="/posts/create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BookId" id="bookId" />

                <!-- Tanlangan kitob (tanlangach ko'rinadi) -->
                <div id="selectedBook" class="composer-selected" hidden>
                    <img id="selectedBookCover" src="/img/default-book-cover.webp" alt="Muqova" style="width:34px;height:48px;object-fit:cover;border-radius:4px;flex-shrink:0" />
                    <span id="selectedBookLabel"></span>
                    <button type="button" class="composer-clear" id="clearBook" aria-label="Bekor qilish">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <!-- Kitob qidirish / qo'shish (kitob tanlanmaganda ko'rinadi) -->
                <div id="bookPicker">
                    <div class="composer-book">
                        <input class="input" id="bookSearch" placeholder="Kitobni qidiring..." autocomplete="off" />
                        <button type="button" class="btn btn-outline btn-sm" id="newBookToggle">Yangi kitob</button>
                    </div>
                    <div class="book-suggestions" id="bookSuggestions" hidden></div>

                    <div id="newBookForm" class="composer-newbook stack" hidden>
                        <input class="input" id="nbTitle" placeholder="Kitob nomi" minlength="3" maxlength="100" />
                        <input class="input" id="nbAuthor" placeholder="Muallif" minlength="3" maxlength="100" />
                        <input class="input" id="nbPages" type="number" min="1" max="100000" placeholder="Sahifalar soni" />

                        <div class="nb-cover">
                            <div class="nb-cover-preview" id="nbCoverPreview">
                                <span class="material-symbols-outlined">image</span>
                            </div>
                            <div class="nb-cover-actions">
                                <label class="btn btn-outline btn-sm" for="nbCover">Muqova rasmi</label>
                                <input type="file" id="nbCover" accept="image/*" hidden />
                                <button type="button" class="btn btn-ghost btn-sm" id="nbCoverClear" hidden>O'chirish</button>
                                <span class="muted" id="nbCoverHint" style="font-size:12px">Ixtiyoriy — JPG/PNG, 10 MB gacha.</span>
                            </div>
                        </div>

                        <button type="button" class="btn btn-outline btn-sm" id="nbSave">Kitobni qo'shish</button>
                    </div>
                </div>

                <partial name="_RichEditor" model='new KitobdaGimen.Web.Models.RichEditorModel { Name = "ReviewText", Placeholder = "Kitob haqida fikringizni yozing...", MinLength = 3, MaxLength = 5000 }' />


                <div class="composer-image-picker">
                    <input type="hidden" name="ImageUrl" id="postImageUrl" />
                    <div id="postImagePreview" class="composer-image-preview" hidden>
                        <img id="postImagePreviewImg" src="" alt="Tanlangan rasm" />
                        <button type="button" class="composer-image-remove" id="postImageClear" aria-label="Rasmni o'chirish">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <label class="btn btn-outline btn-sm" for="postImage">
                        <span class="material-symbols-outlined ic-sm ic-baseline">image</span>
                        Rasm qo'shish
                    </label>
                    <input type="file" id="postImage" accept="image/*" hidden />
                </div>

                <div class="composer-actions">
                    <span class="muted" id="composerHint" style="font-size:13px">Avval kitobni tanlang yoki qo'shing.</span>
                    <button type="submit" class="btn btn-primary" id="postSubmit" disabled>Joylash</button>
                </div>
            </form>
            </div>
        </div>

        <!-- Iqtibos modali -->
        <div class="composer-modal" id="quoteComposerModal" hidden>
            <div class="composer-modal-backdrop" data-quote-composer-close></div>
            <div class="composer-modal-box card" role="dialog" aria-modal="true" aria-label="Yangi iqtibos">
                <div class="composer-modal-head">
                    <h3>Qaysi kitobdan iqtibos qo'shasiz?</h3>
                    <button type="button" class="composer-close" data-quote-composer-close aria-label="Yopish">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

            <form id="quoteComposerForm" method="post" action="/quotes/create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BookId" id="quoteBookId" />

                <!-- Tanlangan kitob (tanlangach ko'rinadi) -->
                <div id="quoteSelectedBook" class="composer-selected" hidden>
                    <span class="material-symbols-outlined">menu_book</span>
                    <span id="quoteSelectedBookLabel"></span>
                    <button type="button" class="composer-clear" id="quoteClearBook" aria-label="Bekor qilish">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <!-- Kitob qidirish / qo'shish (kitob tanlanmaganda ko'rinadi) -->
                <div id="quoteBookPicker">
                    <div class="composer-book">
                        <input class="input" id="quoteBookSearch" placeholder="Kitobni qidiring..." autocomplete="off" />
                        <button type="button" class="btn btn-outline btn-sm" id="quoteNewBookToggle">Yangi kitob</button>
                    </div>
                    <div class="book-suggestions" id="quoteBookSuggestions" hidden></div>

                    <div id="quoteNewBookForm" class="composer-newbook stack" hidden>
                        <input class="input" id="qNbTitle" placeholder="Kitob nomi" minlength="3" maxlength="100" />
                        <input class="input" id="qNbAuthor" placeholder="Muallif" minlength="3" maxlength="100" />
                        <input class="input" id="qNbPages" type="number" min="1" max="100000" placeholder="Sahifalar soni" />

                        <div class="nb-cover">
                            <div class="nb-cover-preview" id="qNbCoverPreview">
                                <span class="material-symbols-outlined">image</span>
                            </div>
                            <div class="nb-cover-actions">
                                <label class="btn btn-outline btn-sm" for="qNbCover">Muqova rasmi</label>
                                <input type="file" id="qNbCover" accept="image/*" hidden />
                                <button type="button" class="btn btn-ghost btn-sm" id="qNbCoverClear" hidden>O'chirish</button>
                                <span class="muted" id="qNbCoverHint" style="font-size:12px">Ixtiyoriy — JPG/PNG, 10 MB gacha.</span>
                            </div>
                        </div>

                        <button type="button" class="btn btn-outline btn-sm" id="qNbSave">Kitobni qo'shish</button>
                    </div>
                </div>

                <textarea class="input" name="Text" id="quoteText" placeholder="Iqtibos matni..." minlength="3" maxlength="400" required></textarea>

                <div class="composer-image-picker" style="margin-top:10px">
                    <input type="hidden" name="ImageUrl" id="quoteImageUrl" />
                    <div id="quoteImagePreview" class="composer-image-preview" hidden>
                        <img id="quoteImagePreviewImg" src="" alt="Tanlangan rasm" />
                        <button type="button" class="composer-image-remove" id="quoteImageClear" aria-label="Rasmni o'chirish">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <label class="btn btn-outline btn-sm" for="quoteImage">
                        <span class="material-symbols-outlined ic-sm ic-baseline">image</span>
                        Rasm qo'shish
                    </label>
                    <input type="file" id="quoteImage" accept="image/*" hidden />
                </div>

                <div class="composer-actions">
                    <span class="muted" id="quoteComposerHint" style="font-size:13px">Avval kitobni tanlang yoki qo'shing.</span>
                    <button type="submit" class="btn btn-primary" id="quoteSubmit" disabled>Saqlash</button>
                </div>
            </form>
            </div>
        </div>
        }

        <!-- Taqrizlar -->
        @if (Model.Feed.Items.Count == 0)
        {
            <div class="card empty-state">
                <span class="material-symbols-outlined">@(string.IsNullOrEmpty(search) ? "auto_stories" : "search_off")</span>
                <p>
                    @(string.IsNullOrEmpty(search)
                        ? "Hozircha taqriz yo'q. Birinchi bo'lib fikr ulashing yoki boshqa kitobxonlarni kuzating!"
                        : $"\"{search}\" bo'yicha taqriz topilmadi.")
                </p>
            </div>
        }
        else
        {
            @foreach (var item in Model.Feed.Items)
            {
                if (item.Kind == "quote" && item.Quote is not null)
                {
                    <partial name="_QuoteFeedCard" model="item.Quote" />
                }
                else if (item.Post is not null)
                {
                    <partial name="_PostCard" model="item.Post" />
                }
            }
        }

        <!-- Pastga tushganda keyingi taqrizlar shu yerga animatsiya bilan qo'shiladi -->
        <div class="infinite-loader" id="feedLoader" hidden>
            <span class="spinner"></span>
        </div>
        <div id="feedSentinel" aria-hidden="true"
             data-page="@Model.Feed.Page" data-total-pages="@Model.Feed.TotalPages" data-search="@search"></div>
    </div>
    </main>

