                const fd = new FormData();
                fd.append("file", f);
                const res = await fetch("/posts/upload-image", {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "RequestVerificationToken": kitob.antiforgeryToken()
                    },
                    body: fd
                });
                if (res.status === 401) {
                    if (window.kitob && window.kitob.showAuthModal) window.kitob.showAuthModal();
                    return;
                }
                if (!res.ok) {
                    let message = "Rasmni yuklab bo'lmadi.";
                    try { const d = await res.json(); message = d.message || message; } catch { /* ignore */ }
                    throw new Error(message);
                }
                const data = await res.json();
                quoteImageUrl.value = data.url;
            } catch (err) {
                alert(err.message);
                resetQuoteImage();
                return;
            } finally {
                quoteImageUploading = false;
                refreshState();
            }
        });
    }

    if (quoteImageClear) {
        quoteImageClear.addEventListener("click", resetQuoteImage);
    }

    form.addEventListener("submit", (e) => {
        if (!bookIdInput.value) {
            e.preventDefault();
            alert("Avval kitobni tanlang yoki qo'shing.");
        } else if (!(quoteText.value || "").trim()) {
            e.preventDefault();
            alert("Iqtibos matnini yozing.");
        } else if (quoteImageUploading) {
            e.preventDefault();
            alert("Rasm hali yuklanmoqda, biroz kuting.");
        }
    });

    refreshState();
})();
</script>
}
