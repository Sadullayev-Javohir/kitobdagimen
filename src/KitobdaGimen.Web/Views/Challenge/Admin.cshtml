@using System.Text.Json
@using KitobdaGimen.Application.Common
@using KitobdaGimen.Application.Features.Challenge.Dtos
@model KitobdaGimen.Web.Models.ChallengeAdminViewModel
@{
    ViewData["Title"] ??= "Challenge — admin";
    ViewData["Robots"] = "noindex, nofollow";

    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpper();
    string MedalIcon(int rank)
    {
        var cls = rank switch { 1 => "ch-medal-gold", 2 => "ch-medal-silver", _ => "ch-medal-bronze" };
        return $"<span class=\"material-symbols-outlined ch-medal-ic {cls}\">workspace_premium</span>";
    }

    var (prevY, prevM) = ChallengeCalendar.PreviousPeriod(Model.Year, Model.Month);
    var (nextY, nextM) = ChallengeCalendar.NextPeriod(Model.Year, Model.Month);
    var podiumOrder = new[] { 2, 1, 3 };

    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var standingsJson = Html.Raw(JsonSerializer.Serialize(Model.Standings, jsonOpts));

    var msg = TempData["ChallengeMsg"] as string;
}

@Html.AntiForgeryToken()

<div class="container page ch-page ch-admin">
    <header class="ch-admin-header">
        <div class="ch-admin-header-main">
            <div class="ch-admin-badge">
                <span class="material-symbols-outlined">tune</span>
                Admin boshqaruvi
            </div>
            <h1 class="ch-admin-title">Challenge monitoring & sozlamalar</h1>
            <p class="muted ch-admin-desc">
                Challenge muddati, sovg'a kitoblar, Telegram guruh integratsiyasi hamda oylik sarhisobni boshqaring.
            </p>
        </div>
        <div class="ch-admin-header-actions">
            <a class="btn btn-outline btn-sm" href="/admin">
                <span class="material-symbols-outlined ic-sm">dashboard</span>
                Admin panel
            </a>
            <a class="btn btn-primary btn-sm" href="/challenge">
                <span class="material-symbols-outlined ic-sm">arrow_outward</span>
                Challenge sahifasi
            </a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="ch-admin-alert">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@msg</span>
        </div>
    }

    @* ================= ADMIN: CHALLENGE VA 1-2-3-O'RIN SOVG'A KITOBLAR BOSHQARUVI ================= *@
    <section class="ch-admin-card">
        <div class="ch-admin-card-head">
            <div>
                <h2>
                    <span class="material-symbols-outlined" style="color:var(--accent)">tune</span>
                    Challenge parametrlari va sovrinlar
                </h2>
                <p>
                    Challenge muddati, Telegram guruh bog'lanishi va 1-, 2-, 3-o'rin kitoblarini sozlang.
                </p>
            </div>
        </div>

        <form method="post" action="/challenge/admin/save-config" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="ch-admin-grid-2">
                <div class="ch-admin-field">
                    <label>
                        <span class="material-symbols-outlined ic-sm">title</span>
                        Challenge sarlavhasi
                    </label>
                    <input class="input" type="text" name="title" value="@Model.Config.Title" placeholder="Masalan: KitobdagiMen — Kuzgi Mutolaa Challenge" required />
                </div>
                <div class="ch-admin-field">
                    <label>
                        <span class="material-symbols-outlined ic-sm">groups</span>
                        Telegram guruh ID (KitobdagiMen)
                    </label>
                    <input class="input" type="text" name="bookClubGroupId" value="@Model.BookClubGroupId" placeholder="Masalan: -1001234567890" />
                    <small>Ixtiyoriy — guruhda <code>/bind_group</code> buyrug'i orqali ham bog'lash mumkin.</small>
                </div>
            </div>

            <div class="ch-admin-grid-2">
                <div class="ch-admin-field">
                    <label>
                        <span class="material-symbols-outlined ic-sm">event</span>
                        Boshlanish sanasi (Start Date)
                    </label>
                    <input class="input" type="date" name="startDate" value="@Model.Config.StartDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="ch-admin-field">
                    <label>
                        <span class="material-symbols-outlined ic-sm">event_available</span>
                        Tugash sanasi (End Date)
                    </label>
                    <input class="input" type="date" name="endDate" value="@Model.Config.EndDate.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="ch-admin-prizes">
                <div class="ch-admin-prizes-title">
                    <span class="material-symbols-outlined">redeem</span>
                    1-, 2-, 3-o'rinlar uchun sovg'a kitoblar
                </div>

                <div class="ch-admin-prizes-grid">
                    @for (var r = 1; r <= 3; r++)
                    {
                        var p = Model.Config.GetPrize(r);
                        var rankClass = r switch { 1 => "ch-prize-card-gold", 2 => "ch-prize-card-silver", _ => "ch-prize-card-bronze" };
                        var rankBadge = r switch { 1 => "1-o'rin sovg'a kitobi", 2 => "2-o'rin sovg'a kitobi", _ => "3-o'rin sovg'a kitobi" };
                        <div class="ch-prize-card @rankClass">
                            <div class="ch-prize-head">
                                <span class="ch-prize-rank-badge">
                                    @Html.Raw(MedalIcon(r))
                                    <span>@rankBadge</span>
                                </span>
                            </div>
                            <div class="ch-admin-field">
                                <label>
                                    <span class="material-symbols-outlined ic-sm">menu_book</span>
                                    Kitob nomi
                                </label>
                                <input class="input" type="text" name="prizeTitle_@r" value="@p.Title" placeholder="Masalan: Atom odatlari" />
                            </div>
                            <div class="ch-admin-field">
                                <label>
                                    <span class="material-symbols-outlined ic-sm">person</span>
                                    Muallif
                                </label>
                                <input class="input" type="text" name="prizeAuthor_@r" value="@p.Author" placeholder="Masalan: Jeyms Klir" />
                            </div>
                            <div class="ch-admin-field">
                                <label>
                                    <span class="material-symbols-outlined ic-sm">photo</span>
                                    Muqova rasmi
                                </label>
                                <div class="ch-file-uploader" data-ch-uploader>
                                    <input type="file"
                                           name="prizeCover_@r"
                                           id="prizeCover_@r"
                                           class="ch-file-uploader-input"
                                           accept="image/jpeg,image/png,image/webp,image/gif" />
                                    <label for="prizeCover_@r" class="ch-file-uploader-zone">
                                        <div class="ch-file-uploader-icon">
                                            <span class="material-symbols-outlined">add_photo_alternate</span>
                                        </div>
                                        <div class="ch-file-uploader-text">
                                            <span class="ch-file-uploader-btn">
                                                <span class="material-symbols-outlined">upload_file</span>
                                                Faylni tanlash
                                            </span>
                                            <span class="ch-file-uploader-hint">yoki rasmni bu yerga torting</span>
                                        </div>
                                    </label>
                                    <div class="ch-file-uploader-preview-bar" hidden>
                                        <img class="ch-file-uploader-thumb" src="" alt="Tanlangan muqova" />
                                        <div class="ch-file-uploader-meta">
                                            <span class="ch-file-uploader-name"></span>
                                            <span class="ch-file-uploader-size"></span>
                                        </div>
                                        <button type="button" class="btn btn-ghost btn-sm ch-file-uploader-clear" title="Bekor qilish">
                                            <span class="material-symbols-outlined">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(p.CoverUrl))
                            {
                                <div class="ch-prize-cover-preview">
                                    <img class="ch-prize-cover-img" src="@p.CoverUrl" alt="@p.Title" />
                                    <div class="ch-prize-cover-meta">
                                        <strong>@p.Title</strong>
                                        <span class="ch-prize-cover-status">
                                            <span class="material-symbols-outlined ic-sm">verified</span>
                                            Joriy muqova saqlangan
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="ch-admin-form-actions">
                <div class="ch-admin-form-actions-left">
                    <button type="submit" class="btn btn-primary">
                        <span class="material-symbols-outlined" style="vertical-align:-4px">save</span>
                        Sozlamalar va kitoblarni saqlash
                    </button>
                </div>
            </div>
        </form>

        <form method="post" action="/challenge/admin/send-daily-report" style="margin-top:14px; padding-top:14px; border-top:1px dashed var(--border)">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline btn-sm">
                <span class="material-symbols-outlined ic-sm" style="vertical-align:-3px">send</span>
                Bugungi (23:59) kunlik mutolaa hisobotini hozir Telegram'ga yuborish
            </button>
        </form>
    </section>

    @* Davr navigatsiyasi *@
    <div class="ch-period-nav">
        <a class="btn btn-sm btn-outline" href="/challenge/admin?year=@prevY&month=@prevM">
            <span class="material-symbols-outlined" style="vertical-align:-4px">chevron_left</span> Oldingi davr
        </a>
        <div class="ch-period-label">
            <strong>@Model.PeriodLabel</strong>
            <div>
                @if (Model.Announced is not null)
                {
                    <span class="ch-status is-announced"><span class="material-symbols-outlined">check_circle</span> E'lon qilingan</span>
                }
                else if (Model.IsPeriodCompleted)
                {
                    <span class="ch-status is-completed"><span class="material-symbols-outlined">hourglass_top</span> Yakunlangan — e'lon qilinmagan</span>
                }
                else
                {
                    <span class="ch-status is-live"><span class="material-symbols-outlined">radio_button_checked</span> Davom etmoqda (jonli)</span>
                }
            </div>
        </div>
        <a class="btn btn-sm btn-outline" href="/challenge/admin?year=@nextY&month=@nextM">
            Keyingi davr <span class="material-symbols-outlined" style="vertical-align:-4px">chevron_right</span>
        </a>
    </div>

    @* Amallar *@
    <div class="ch-actions">
        <button type="button" class="btn btn-accent" data-preview-modal>
            <span class="material-symbols-outlined" style="vertical-align:-4px">slideshow</span>
            G'olib modalini ko'rish (preview)
        </button>
        <button type="button" class="btn btn-outline" data-festive-toggle>
            <span class="material-symbols-outlined" style="vertical-align:-4px">celebration</span>
            Bayram ko'rinishini sinash
        </button>
        @if (Model.Announced is null && Model.IsSuperAdmin)
        {
            <button type="button" class="btn btn-primary" data-announce-open @(Model.Standings.Count == 0 ? "disabled" : "")>
                <span class="material-symbols-outlined" style="vertical-align:-4px">campaign</span>
                G'oliblarni e'lon qilish
            </button>
        }
    </div>

    @if (Model.Announced is null && !Model.IsSuperAdmin)
    {
        <p class="muted" style="margin-bottom:20px">
            <span class="material-symbols-outlined ic-sm" style="vertical-align:-4px">info</span>
            G'oliblar odatda davr oxirida avtomatik e'lon qilinadi. Avtomatik jarayon ishlamay qolsa,
            faqat <strong>super admin</strong> qo'lda e'lon qila oladi.
        </p>
    }

    @* Reyting preview (podium) *@
    <section class="ch-section">
        <h2 class="ch-h2"><span class="material-symbols-outlined">leaderboard</span> Reyting (top 3)</h2>
        @if (Model.Standings.Count == 0)
        {
            <div class="card ch-empty">
                <span class="material-symbols-outlined">auto_stories</span>
                <h3>Bu davrda o'qish yozuvi yo'q</h3>
                <p class="muted">Bu oy uchun hali reyting shakllanmagan.</p>
            </div>
        }
        else
        {
            <div class="ch-podium">
                @foreach (var slot in podiumOrder)
                {
                    var u = Model.Standings.FirstOrDefault(x => x.Rank == slot);
                    if (u is null) { continue; }
                    <div class="ch-podium-card ch-place-@u.Rank">
                        <div class="ch-medal">@Html.Raw(MedalIcon(u.Rank))</div>
                        <div class="ch-avatar-wrap">
                            @if (!string.IsNullOrEmpty(u.AvatarUrl))
                            {
                                <img class="avatar ch-avatar" src="@u.AvatarUrl" alt="@u.FullName" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span class="avatar ch-avatar">@Initial(u.FullName)</span>
                            }
                            <span class="ch-rank-badge">@u.Rank</span>
                        </div>
                        <div class="ch-name" title="@u.FullName">@u.FullName</div>
                        <div class="ch-score"><strong>@u.PagesRead</strong> bet</div>
                        <div class="ch-detail muted">@u.BooksRead kitob · kuniga @u.AvgPagesPerDay bet</div>
                        <div class="ch-pillar">
                            <span class="ch-pillar-num">@u.Rank</span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* Super admin: sovg'a kitob (faqat e'lon qilingandan keyin — 1-, 2-, 3-o'rin uchun) *@
    @if (Model.IsSuperAdmin && Model.Announced is not null && Model.Announced.Winners.Count > 0)
    {
        <section class="ch-section">
            <h2 class="ch-h2"><span class="material-symbols-outlined">redeem</span> G'oliblarga kitob sovg'a qilish</h2>
            <p class="muted ch-note">Har bir g'olibga (1-, 2-, 3-o'rin) bittadan kitob sovg'a qilishingiz mumkin.</p>
            @foreach (var win in Model.Announced.Winners.OrderBy(w => w.Rank))
            {
                <div class="ch-gift-form">
                    <div class="ch-gift-form-header">
                        <div>
                            @Html.Raw(MedalIcon(win.Rank)) <strong>@win.Rank-o'rin — @win.FullName</strong>
                            @if (!string.IsNullOrEmpty(win.GiftBookTitle))
                            {
                                <span class="muted">· Joriy sovg'a: <strong>@win.GiftBookTitle</strong></span>
                            }
                        </div>
                    </div>
                    <form method="post" action="/challenge/admin/gift" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="year" value="@Model.Year" />
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="rank" value="@win.Rank" />
                        <div class="ch-admin-grid-2">
                            <div class="ch-admin-field">
                                <label>Kitob nomi</label>
                                <input class="input" type="text" name="title" value="@win.GiftBookTitle" placeholder="Masalan: Atom odatlari" required />
                            </div>
                            <div class="ch-admin-field">
                                <label>Muallif</label>
                                <input class="input" type="text" name="author" value="@win.GiftBookAuthor" placeholder="Masalan: Jeyms Klir" />
                            </div>
                        </div>
                        <div class="ch-admin-field" style="margin-bottom:14px">
                            <label>
                                <span class="material-symbols-outlined ic-sm">photo</span>
                                Muqova rasmi (yuklash)
                            </label>
                            <div class="ch-file-uploader" data-ch-uploader>
                                <input type="file"
                                       name="cover"
                                       id="giftCover_@win.Rank"
                                       class="ch-file-uploader-input"
                                       accept="image/jpeg,image/png,image/webp,image/gif" />
                                <label for="giftCover_@win.Rank" class="ch-file-uploader-zone">
                                    <div class="ch-file-uploader-icon">
                                        <span class="material-symbols-outlined">add_photo_alternate</span>
                                    </div>
                                    <div class="ch-file-uploader-text">
                                        <span class="ch-file-uploader-btn">
                                            <span class="material-symbols-outlined">upload_file</span>
                                            Faylni tanlash
                                        </span>
                                        <span class="ch-file-uploader-hint">JPG, PNG, WEBP yoki GIF</span>
                                    </div>
                                </label>
                                <div class="ch-file-uploader-preview-bar" hidden>
                                    <img class="ch-file-uploader-thumb" src="" alt="Tanlangan muqova" />
                                    <div class="ch-file-uploader-meta">
                                        <span class="ch-file-uploader-name"></span>
                                        <span class="ch-file-uploader-size"></span>
                                    </div>
                                    <button type="button" class="btn btn-ghost btn-sm ch-file-uploader-clear" title="Bekor qilish">
                                        <span class="material-symbols-outlined">close</span>
                                    </button>
                                </div>
                            </div>
                            <small class="muted" style="margin-top:4px">JPG, PNG, WEBP yoki GIF formatlarida (maks. 5MB).</small>
                        </div>
                        <button type="submit" class="btn btn-accent btn-sm">
                            <span class="material-symbols-outlined ic-sm" style="vertical-align:-3px">save</span>
                            @win.Rank-o'rin sovg'asini saqlash
                        </button>
                    </form>
                    @if (!string.IsNullOrEmpty(win.GiftBookCoverUrl))
                    {
                        <div class="ch-prize-cover-preview" style="margin-top:12px; max-width:360px">
                            <img class="ch-prize-cover-img" src="@win.GiftBookCoverUrl" alt="@win.GiftBookTitle" referrerpolicy="no-referrer" />
                            <div class="ch-prize-cover-meta">
                                <strong>@win.GiftBookTitle</strong>
                                <span class="muted" style="color:var(--text-secondary)">@win.GiftBookAuthor</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
    else if (Model.IsSuperAdmin && Model.Announced is null)
    {
        <p class="muted">Sovg'a kitob kiritish uchun avval oyni e'lon qiling.</p>
    }
</div>

@* Preview modal (standings'dan quriladi) *@
<div class="ch-modal" data-preview-modal-box hidden>
    <div class="ch-modal-backdrop" data-preview-close></div>
    <div class="ch-modal-box" role="dialog" aria-modal="true">
        <div class="ch-modal-header">
            <div class="ch-modal-confetti" aria-hidden="true"></div>
            <button type="button" class="ch-modal-x" data-preview-close aria-label="Yopish">
                <span class="material-symbols-outlined">close</span>
            </button>
            <span class="material-symbols-outlined ch-modal-crown">workspace_premium</span>
            <h2 class="ch-modal-title">@Model.PeriodLabel g'oliblari (preview)</h2>
            <p class="ch-modal-sub">Foydalanuvchilar shu ko'rinishni ko'radi.</p>
        </div>
        <div class="ch-modal-winners" data-preview-winners></div>
        <button type="button" class="btn btn-accent" data-preview-close>Yopish</button>
    </div>
</div>

@* E'lon qilish oynasi — g'oliblarga sovg'a kitob biriktirib, birga e'lon qilish *@
@if (Model.Announced is null && Model.IsSuperAdmin && Model.Standings.Count > 0)
{
    <div class="ch-modal" data-announce-modal hidden>
        <div class="ch-modal-backdrop" data-announce-close></div>
        <div class="ch-modal-box" role="dialog" aria-modal="true">
            <div class="ch-modal-header">
                <button type="button" class="ch-modal-x" data-announce-close aria-label="Yopish">
                    <span class="material-symbols-outlined">close</span>
                </button>
                <span class="material-symbols-outlined ch-modal-crown">campaign</span>
                <h2 class="ch-modal-title">@Model.PeriodLabel g'oliblarini e'lon qilish</h2>
                <p class="ch-modal-sub">Har bir g'olibga sovg'a kitob biriktiring (ixtiyoriy), so'ng e'lon qiling.</p>
            </div>
            <form method="post" action="/challenge/admin/announce" enctype="multipart/form-data" class="ch-announce-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                @foreach (var u in Model.Standings.OrderBy(x => x.Rank))
                {
                    <div class="card ch-gift-form" style="margin:0 16px 12px;text-align:left">
                        <p class="muted" style="margin-bottom:10px">
                            @Html.Raw(MedalIcon(u.Rank)) <strong>@u.Rank-o'rin — @u.FullName</strong>
                            <span class="muted">· @u.PagesRead bet · @u.BooksRead kitob</span>
                        </p>
                        <div class="ch-admin-grid-2">
                            <div class="ch-admin-field">
                                <label>Kitob nomi</label>
                                <input class="input" type="text" name="title_@u.Rank" placeholder="Masalan: Atom odatlari" />
                            </div>
                            <div class="ch-admin-field">
                                <label>Muallif</label>
                                <input class="input" type="text" name="author_@u.Rank" placeholder="Masalan: Jeyms Klir" />
                            </div>
                        </div>
                        <div class="ch-admin-field" style="margin-top:10px">
                            <label>
                                <span class="material-symbols-outlined ic-sm">photo</span>
                                Muqova rasmi (yuklash)
                            </label>
                            <div class="ch-file-uploader" data-ch-uploader>
                                <input type="file"
                                       name="cover_@u.Rank"
                                       id="announceCover_@u.Rank"
                                       class="ch-file-uploader-input"
                                       accept="image/jpeg,image/png,image/webp,image/gif" />
                                <label for="announceCover_@u.Rank" class="ch-file-uploader-zone">
                                    <div class="ch-file-uploader-icon">
                                        <span class="material-symbols-outlined">add_photo_alternate</span>
                                    </div>
                                    <div class="ch-file-uploader-text">
                                        <span class="ch-file-uploader-btn">
                                            <span class="material-symbols-outlined">upload_file</span>
                                            Faylni tanlash
                                        </span>
                                        <span class="ch-file-uploader-hint">JPG, PNG, WEBP yoki GIF</span>
                                    </div>
                                </label>
                                <div class="ch-file-uploader-preview-bar" hidden>
                                    <img class="ch-file-uploader-thumb" src="" alt="Tanlangan muqova" />
                                    <div class="ch-file-uploader-meta">
                                        <span class="ch-file-uploader-name"></span>
                                        <span class="ch-file-uploader-size"></span>
                                    </div>
                                    <button type="button" class="btn btn-ghost btn-sm ch-file-uploader-clear" title="Bekor qilish">
                                        <span class="material-symbols-outlined">close</span>
                                    </button>
                                </div>
                            </div>
                            <small class="muted" style="margin-top:4px">JPG, PNG, WEBP yoki GIF (maks. 5MB).</small>
                        </div>
                    </div>
                }
                <div style="text-align:center;padding:12px 16px 6px">
                    <button type="submit" class="btn btn-primary"
                            onclick="return confirm('@Model.PeriodLabel uchun g\'oliblarni e\'lon qilishni tasdiqlaysizmi? Bu amalni orqaga qaytarib bo\'lmaydi.');">
                        <span class="material-symbols-outlined" style="vertical-align:-4px">campaign</span>
                        E'lon qilish va sovg'alarni saqlash
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<link rel="stylesheet" href="/css/challenge.css" asp-append-version="true" />

@section Scripts {
    <script type="application/json" data-preview-standings>@standingsJson</script>
    <script src="~/js/challenge-admin.js" asp-append-version="true"></script>
}
