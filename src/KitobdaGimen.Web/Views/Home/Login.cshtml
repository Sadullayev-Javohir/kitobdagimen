@inject KitobdaGimen.Application.Common.Interfaces.ITelegramBotService TelegramBot
@{
    ViewData["Title"] = "Kirish";
    ViewData["HideChrome"] = true;
    ViewData["Robots"] = "noindex, follow";
    var botUsername = TelegramBot.BotUsername;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var loginError = TempData["LoginError"] as string;
}

<div class="login-page">
    <div class="login-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
            <a href="/" class="btn btn-ghost btn-sm" style="padding:6px 10px">
                <span class="material-symbols-outlined ic-18">arrow_back</span> Asosiy sahifa
            </a>
            <button type="button" class="nav-icon-btn" data-theme-toggle title="Kun / Tun rejimi" aria-label="Kun / Tun rejimi">
                <span class="material-symbols-outlined theme-icon">dark_mode</span>
            </button>
        </div>

        <img class="login-logo" src="~/img/logo.png" alt="kitobdagimen.uz" />
        <h1 class="login-title">kitobdagimen<span class="brand-dot">.uz</span></h1>
        <p class="login-sub" style="margin-bottom:20px">Telegram orqali kirish</p>

        @if (!string.IsNullOrWhiteSpace(loginError))
        {
            <div class="lp-alert" style="margin-bottom:16px; text-align:left">
                <span class="material-symbols-outlined ic-18" style="vertical-align:-4px">error</span>
                @loginError
            </div>
        }

        <a class="btn btn-block" href="https://t.me/@(botUsername)?start=web" target="_blank" rel="noopener noreferrer" style="background:#0284c7; border-color:#0284c7; color:#fff; padding:11px 16px; display:inline-flex; align-items:center; justify-content:center; gap:8px; font-weight:600; margin-bottom:16px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            Telegramdan kod olish
        </a>

        <form method="post" action="/auth/telegram-login" style="margin-bottom:14px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <input type="text"
                   name="code"
                   class="login-code-input"
                   inputmode="numeric"
                   pattern="[0-9\s]{6,8}"
                   maxlength="8"
                   autocomplete="one-time-code"
                   placeholder="Kirish kodi"
                   required
                   autofocus />

            <button type="submit" class="btn btn-primary btn-block" style="padding:12px 18px; font-size:0.98rem">
                Kirish
            </button>
        </form>

        <p class="login-terms muted" style="margin-top:12px">
            <a href="/qollanma">Foydalanish qoidalari</a>
        </p>
    </div>
</div>
