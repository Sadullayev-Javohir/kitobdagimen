@inject KitobdaGimen.Application.Common.Interfaces.ICurrentUserService CurrentUser
@using KitobdaGimen.Web.Seo
@{
    var seoBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData["Title"] = "Foydalanish qo'llanmasi — kitobdagimen.uz";
    ViewData["HideChrome"] = true;
    ViewData["Description"] = "kitobdagimen.uz platformasidan foydalanish bo'yicha to'liq qo'llanma: barcha imkoniyatlar, kitoblar, chellenjlar, telegram bot, kutubxona va iqtiboslar haqida qisqa tushuntirish.";
    ViewData["Canonical"] = $"{seoBase}/qollanma";
    ViewData["OgType"] = "article";
    ViewData["JsonLdBreadcrumbs"] = SeoJsonLd.Breadcrumb(seoBase, ("Bosh sahifa", "/"), ("Qo'llanma", "/qollanma"));

    var isAuth = CurrentUser.IsAuthenticated;
    var primaryHref = isAuth ? "/feed" : "/login";
    var primaryLabel = isAuth ? "Tasmaga o'tish" : "Kirish";
}

<div class="lp-shell">
    <div class="lp-header-sticky">
        <header class="lp-nav">
            <a class="brand" href="/">
                <img class="brand-logo" src="~/img/logo.png" alt="kitobdagimen.uz logotipi" />
                <span class="brand-text">kitobdagimen<span class="brand-dot">.uz</span></span>
            </a>
            <nav class="lp-nav-links">
                <a href="/">Bosh sahifa</a>
                <a href="/#imkoniyatlar">Imkoniyatlar</a>
                <a href="/challenge">Challenge</a>
                <a href="/reading-books">Kitoblar</a>
            </nav>
            <div class="lp-nav-right">
                <button type="button" class="nav-icon-btn" data-theme-toggle title="Kun / Tun rejimi" aria-label="Kun / Tun rejimi">
                    <span class="material-symbols-outlined theme-icon">dark_mode</span>
                </button>
                <a class="btn btn-primary btn-sm" href="@primaryHref">@primaryLabel</a>
            </div>
        </header>
    </div>

    <div class="lp guide">
        <section class="lp-hero guide-hero">
            <span class="lp-eyebrow">
                <span class="lp-eyebrow-dot"></span>
                Foydalanish qo'llanmasi
            </span>
            <h1>kitobdagimen.uz platformasi qo'llanmasi</h1>
            <p class="lp-sub">
                Platformadagi barcha mavjud imkoniyatlar va bo'limlar bilan qisqacha tanishing. 
                Quyidagi mundarijadan kerakli bo'limni tanlab, tezkor o'tishingiz mumkin.
            </p>
        </section>

        <nav class="guide-toc" aria-label="Mundarija">
            <h2>Mundarija</h2>
            <ol>
                <li><a href="#kirish">1. Ro'yxatdan o'tish va kirish</a></li>
                <li><a href="#janr">2. Qiziqishlar va tavsiyalar</a></li>
                <li><a href="#tasma">3. Tasma (Lenta) — taqrizlar</a></li>
                <li><a href="#taqriz">4. Taqriz yozish va baholash</a></li>
                <li><a href="#kitoblar">5. Kitoblar qidiruvi va 3D ko'rinish</a></li>
                <li><a href="#kutubxona">6. Kutubxona va o'qish maqsadlari</a></li>
                <li><a href="#reading-books">7. Hozir o'qilayotgan kitoblar</a></li>
                <li><a href="#challenge">8. Kitobxonlik chellenjlari</a></li>
                <li><a href="#bot">9. Telegram bot imkoniyatlari</a></li>
                <li><a href="#iqtibos">10. Iqtiboslar xazinasi</a></li>
                <li><a href="#story">11. Storylar (Hikoyalar)</a></li>
                <li><a href="#profil">12. Profil va kuzatish</a></li>
                <li><a href="#sarhisob">13. Yillik sarhisob</a></li>
                <li><a href="#bildirishnoma">14. Bildirishnomalar va qulayliklar</a></li>
            </ol>
        </nav>

        <article class="guide-body">

            <!-- 1. Kirish -->
            <section class="guide-step" id="kirish">
                <span class="guide-step-num">1</span>
                <div class="guide-step-content">
                    <h2>Ro'yxatdan o'tish va kirish</h2>
                    <p>Platformadan foydalanish uchun ortiqcha parol yoki email tasdiqlash talab qilinmaydi.</p>
                    <ul class="guide-list">
                        <li><strong>Google hisobi</strong> orqali bitta tugmani bosib tizimga tezkor kiring.</li>
                        <li>Hisobingiz ma'lumotlari avtomatik xavfsiz saqlanadi.</li>
                        <li>Keyingi safar tizim sizni to'g'ridan-to'g'ri shaxsiy tasmangizga olib kiradi.</li>
                    </ul>
                    <p class="guide-tip"><span class="material-symbols-outlined">lightbulb</span> Parol eslab qolish shart emas, har doim Google profilingiz orqali osongina kirasiz.</p>
                </div>
            </section>

            <!-- 2. Qiziqishlar -->
            <section class="guide-step" id="janr">
                <span class="guide-step-num">2</span>
                <div class="guide-step-content">
                    <h2>Qiziqishlar va tavsiyalar (Onboarding)</h2>
                    <p>Tizim sizga mos kitoblarni tavsiya qilishi uchun yoqtirgan adabiy janrlaringizni belgilang.</p>
                    <ul class="guide-list">
                        <li>Badiiy, ilmiy-ommabop, biznes, psixologiya, tarix va boshqa yo'nalishlarni tanlang.</li>
                        <li>Profil nomingiz va foydalanuvchi ma'lumotlaringizni kiriting.</li>
                        <li>Qiziqishlaringiz asosida asosiy lentada shaxsiy tavsiyalar paydo bo'ladi.</li>
                    </ul>
                    <p class="guide-tip"><span class="material-symbols-outlined">lightbulb</span> Janrlarni istalgan vaqtda profilingiz sozlamalaridan o'zgartirishingiz mumkin.</p>
                </div>
            </section>

            <!-- 3. Tasma -->
            <section class="guide-step" id="tasma">
                <span class="guide-step-num">3</span>
                <div class="guide-step-content">
                    <h2>Tasma (Lenta) — taqrizlar o'qish</h2>
                    <p>Barcha faol kitobxonlarning eng yangi fikr-mulohazalari va tavsiyalari bir joyda jamlangan.</p>
                    <ul class="guide-list">
                        <li><strong>Aqlli saralash:</strong> o'zingiz kuzatayotgan do'stlaringiz taqrizlari birinchi bo'lib ko'rsatiladi.</li>
                        <li>Har bir taqrizni to'liq ochib o'qish, unga fikr bildirish yoki saqlab qo'yish mumkin.</li>
                        <li>Tasma tepasida faol foydalanuvchilarning yangi storylari qulay joylashgan.</li>
                    </ul>
                </div>
            </section>

            <!-- 4. Taqriz yozish -->
            <section class="guide-step" id="taqriz">
                <span class="guide-step-num">4</span>
                <div class="guide-step-content">
                    <h2>Taqriz yozish va baholash</h2>
                    <p>O'qigan kitoblaringiz haqidagi taassurotlaringizni jamiyat bilan o'rtoqlashing.</p>
                    <ul class="guide-list">
                        <li>Tasma tepasidagi maydonga fikringizni yozing va qidiruv orqali tegishli kitobni biriktiring.</li>
                        <li>Kitobga <strong>1 dan 5 yulduzgacha</strong> shaxsiy bahoyingizni bering.</li>
                        <li>Taqrizlarga layk bosing, izoh yozing, boshqalarning fikriga javob qaytaring yoki havolasini ulashing.</li>
                    </ul>
                    <p class="guide-tip"><span class="material-symbols-outlined">lightbulb</span> O'z taqrizlaringizni xohlagan paytda tahrirlashingiz yoki o'chirishingiz mumkin.</p>
                </div>
            </section>

            <!-- 5. Kitoblar qidiruvi va 3D -->
            <section class="guide-step" id="kitoblar">
                <span class="guide-step-num">5</span>
                <div class="guide-step-content">
                    <h2>Kitoblar qidiruvi va 3D ko'rinish</h2>
                    <p>Platformada 9 000 dan ortiq boy kitoblar katalogi mavjud.</p>
                    <ul class="guide-list">
                        <li><strong>Qulay qidiruv:</strong> o'zbek tilidagi barcha tutuq belgilari va harflar (o‘, g‘, ', ‘) normallashtiriladi — kitoblar bir zumda topiladi.</li>
                        <li><strong>3D interaktiv muqova:</strong> kitoblarni 3D formatda har tomondan tomosha qilish imkoniyati mavjud.</li>
                        <li>Kitob sahifasida uning umumiy betlari, janri, unga yozilgan barcha taqrizlar va iqtiboslar keltiriladi.</li>
                        <li>Katalogda yo'q kitobni bir necha soniyada o'zingiz ham qo'sha olasiz.</li>
                    </ul>
                </div>
            </section>

            <!-- 6. Kutubxona va maqsadlar -->
            <section class="guide-step" id="kutubxona">
                <span class="guide-step-num">6</span>
                <div class="guide-step-content">
                    <h2>Kutubxona va o'qish maqsadlari</h2>
                    <p>Shaxsiy mutolaa rejalaringiz va o'qish intizomingizni boshqaring.</p>
                    <ul class="guide-list">
                        <li>Kitoblarni holati bo'yicha ajrating: <strong>O'qilmoqda</strong>, <strong>O'qilgan</strong> yoki <strong>Rejada</strong>.</li>
                        <li>Har bir kitob uchun o'qilgan joriy sahifani kiriting — tizim foizda rivojlanishingizni ko'rsatadi.</li>
                        <li><strong>Yillik maqsad:</strong> bir yilda nechta kitob o'qishni rejalashtiring va maqsadingizga qadam-baqadam erishing.</li>
                    </ul>
                </div>
            </section>

            <!-- 7. Hozir o'qilayotgan kitoblar -->
            <section class="guide-step" id="reading-books">
                <span class="guide-step-num">7</span>
                <div class="guide-step-content">
                    <h2>Hozir o'qilayotgan kitoblar (/reading-books)</h2>
                    <p>Boshqa kitobxonlar ayni daqiqalarda nimalarni mutolaa qilayotganini jonli kuzating.</p>
                    <ul class="guide-list">
                        <li>Kitobxonlar o'qiyotgan kitoblar, ularning o'qish jarayoni va qiziqarli asarlarni kashf eting.</li>
                        <li>O'zingizga yoqqan kitoblarni bir bosish bilan o'z kutubxonangizga qo'shib oling.</li>
                    </ul>
                </div>
            </section>

            <!-- 8. Chellenjlar -->
            <section class="guide-step" id="challenge">
                <span class="guide-step-num">8</span>
                <div class="guide-step-content">
                    <h2>Kitobxonlik chellenjlari (/challenge)</h2>
                    <p>O'qish odatini kuchaytirish uchun ommaviy kitob marafonlarida qatnashing.</p>
                    <ul class="guide-list">
                        <li>Faol chellenjlarga qo'shiling va o'qigan sahifalaringizni muntazam belgilab boring.</li>
                        <li><strong>Reyting jadvali:</strong> eng faol kitobxonlar orasida o'z o'rningizni ko'ring va peshqadamlar qatoriga kiring.</li>
                        <li>Do'stlaringiz bilan musobaqalashish mutolaaga qo'shimcha ishtiyoq beradi.</li>
                    </ul>
                </div>
            </section>

            <!-- 9. Telegram Bot -->
            <section class="guide-step" id="bot">
                <span class="guide-step-num">9</span>
                <div class="guide-step-content">
                    <h2>Telegram bot imkoniyatlari</h2>
                    <p>Saytga kirmasdan, to'g'ridan-to'g'ri Telegram orqali ham barcha asosiy amallarni bajaring.</p>
                    <ul class="guide-list">
                        <li><strong>Kitob qidiruvi:</strong> boti orqali kitoblarni qidiring, ma'lumotlarini ko'ring va ularni o'qilayotgan kitoblarga biriktiring.</li>
                        <li><strong>Sahifalarni belgilash:</strong> har kuni o'qigan betlaringizni botga tezkor yuboring — hisobingiz avtomatik yangilanadi.</li>
                        <li>Yangi bildirishnomalar va eslatmalarni to'g'ridan-to'g'ri Telegramingizda qabul qiling.</li>
                    </ul>
                    <p class="guide-tip"><span class="material-symbols-outlined">lightbulb</span> Profilingiz sozlamalaridan Telegram hisobingizni osonlikcha bog'lab olishingiz mumkin.</p>
                </div>
            </section>

            <!-- 10. Iqtiboslar -->
            <section class="guide-step" id="iqtibos">
                <span class="guide-step-num">10</span>
                <div class="guide-step-content">
                    <h2>Iqtiboslar xazinasi</h2>
                    <p>Asarlardagi eng ibratli va chuqur satrlarni bir joyga to'plang.</p>
                    <ul class="guide-list">
                        <li>Yoqqan iqtiboslarni kitobiga biriktirgan holda platformaga qo'shing.</li>
                        <li>Boshqa foydalanuvchilarning iqtiboslarini yoqtiring va <strong>"Saqlanganlar"</strong> ro'yxatingizga olib qo'ying.</li>
                        <li>Iqtiboslarni chiroyli formatda ijtimoiy tarmoqlarga ulashing.</li>
                    </ul>
                </div>
            </section>

            <!-- 11. Storylar -->
            <section class="guide-step" id="story">
                <span class="guide-step-num">11</span>
                <div class="guide-step-content">
                    <h2>Storylar (Hikoyalar)</h2>
                    <p>Mutolaa muhiti va kundalik lahzalaringizni qisqa hikoyalar orqali bo'lishing.</p>
                    <ul class="guide-list">
                        <li>Rasm va qisqa matn qo'shib, <strong>12, 24 yoki 48 soatlik</strong> story qoldiring.</li>
                        <li>Boshqa kitobxonlarning storylarini ko'ring va munosabat bildiring.</li>
                        <li>Muddati tugagach, story avtomatik tarzda o'chadi.</li>
                    </ul>
                </div>
            </section>

            <!-- 12. Profil -->
            <section class="guide-step" id="profil">
                <span class="guide-step-num">12</span>
                <div class="guide-step-content">
                    <h2>Profil va kuzatish</h2>
                    <p>Sizning kitobxonlikdagi shaxsiy tashrif qog'ozingiz.</p>
                    <ul class="guide-list">
                        <li>Avataringiz, shioringiz (motto), biografiyangiz va ijtimoiy tarmoq havolalaringizni kiriting.</li>
                        <li>O'qilgan kitoblar, taqrizlar soni va erishilgan natijalar profilingizda aks etadi.</li>
                        <li>Didiga qiziqqan kitobxonlarni <strong>kuzatish (follow)</strong> orqali ularning yangiliklaridan xabardor bo'ling.</li>
                    </ul>
                </div>
            </section>

            <!-- 13. Sarhisob -->
            <section class="guide-step" id="sarhisob">
                <span class="guide-step-num">13</span>
                <div class="guide-step-content">
                    <h2>Yillik sarhisob (Yil yakunlari)</h2>
                    <p>Bir yil davomida bosib o'tgan kitobxonlik sayohatingizning to'liq xulosasi.</p>
                    <ul class="guide-list">
                        <li>Nechta kitob va umumiy qancha sahifa o'qiganingiz chiroyli infografikada ko'rsatiladi.</li>
                        <li>Eng faol o'qigan oylaringiz, sevimli janrlaringiz va eng yaxshi taqrizlaringiz jamlanadi.</li>
                        <li>Natijalaringizni rasm ko'rinishida do'stlaringizga ulashishingiz mumkin.</li>
                    </ul>
                </div>
            </section>

            <!-- 14. Bildirishnomalar va qulayliklar -->
            <section class="guide-step" id="bildirishnoma">
                <span class="guide-step-num">14</span>
                <div class="guide-step-content">
                    <h2>Bildirishnomalar va qulayliklar</h2>
                    <p>Har qanday qurilmada oson va qulay mutolaa muhiti.</p>
                    <ul class="guide-list">
                        <li><strong>Real vaqt bildirishnomalari:</strong> taqrizingizga layk, izoh yoki yangi obunachi bo'lganda tezda xabar olasiz.</li>
                        <li><strong>Kun / Tun rejimi:</strong> ko'zni toliqtirmaydigan qorong'u yoki yorug' mavzuni bir bosish bilan o'zgartiring.</li>
                        <li><strong>Mobil moslashuv:</strong> smartfon, planshet va kompyuterda birdek tezkor va qulay ishlaydi.</li>
                    </ul>
                </div>
            </section>

        </article>

        <section class="lp-cta guide-cta">
            <h2>Hammasi tayyor, boshlashga tayyormisiz?</h2>
            <p>O'zbek kitobxonlari jamiyatiga qo'shiling va mutolaa zavqini birga his eting.</p>
            <a class="btn btn-accent lp-cta-btn-lg" href="@primaryHref">
                @if (isAuth)
                {
                    <text>Tasmaga o'tish</text>
                }
                else
                {
                    <text>Google orqali bepul boshlash</text>
                }
            </a>
        </section>

        <footer class="lp-footer">
            <div class="lp-footer-brand">
                <div class="brand">
                    <img class="brand-logo" src="~/img/logo.png" alt="" />
                    <span class="brand-text">kitobdagimen<span class="brand-dot">.uz</span></span>
                </div>
                <p class="muted">O'zbek kitobxonlari uchun ijtimoiy platforma.</p>
            </div>
            <nav class="lp-footer-links">
                <a href="/">Bosh sahifa</a>
                <a href="/qollanma">Qo'llanma</a>
                <a href="/challenge">Challenge</a>
                <a href="/reading-books">Kitoblar</a>
                <a href="@primaryHref">@primaryLabel</a>
            </nav>
            <p class="lp-copy muted">© 2026 kitobdagimen.uz</p>
        </footer>
    </div>
</div>
