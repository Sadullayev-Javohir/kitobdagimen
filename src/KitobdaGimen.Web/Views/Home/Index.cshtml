@inject KitobdaGimen.Application.Common.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "O'zbek kitobxonlari uchun ijtimoiy platforma";
    ViewData["HideChrome"] = true;

    // --- SEO ---
    var seoReq = Context.Request;
    var seoHost = seoReq.Host.HasValue ? seoReq.Host.Value : "kitobdagimen.uz";
    var seoScheme = seoHost.Contains("localhost") ? seoReq.Scheme : "https";
    var seoBase = $"{seoScheme}://{seoHost}";
    ViewData["Description"] = "kitobdagimen.uz — o'zbek kitobxonlari uchun bepul ijtimoiy platforma. Kitob haqida taqriz yozing, sevimli iqtiboslarni ulashing, oylik kitobxonlik musobaqasida qatnashib kitob yutib oling, o'qish maqsadlari qo'ying va boshqa kitobsevarlar bilan real vaqtda suhbatlashing.";
    ViewData["Canonical"] = seoBase + "/";
    ViewData["OgImage"] = seoBase + "/img/og-image.png";

    var faq = new (string Question, string Answer)[]
    {
        ("Platformadan foydalanish pullikmi?",
            "Yo'q. kitobdagimen.uz to'liq bepul — barcha imkoniyatlar hech qanday to'lovsiz ochiq."),
        ("Qanday ro'yxatdan o'taman?",
            "Rasmiy @KitobdagiMenBot Telegram botiga kirib ism-familiyangiz va username'ingizni kiritasiz. Bot sizga 2 daqiqalik kirish kodi beradi — shu kod orqali veb-saytga bir zumda kirasiz."),
        ("Challenge (musobaqa) qanday ishlaydi?",
            "Admin belgilagan Challenge muddati davomida eng ko'p kitob o'qigan 3 kitobxon g'olib bo'ladi. Yetakchilar reytingi veb-saytda va Telegram botda jonli yangilanib turadi, yakunda esa 1-, 2-, 3-o'rin sohiblari maxsus kitoblar bilan taqdirlanadi."),
        ("G'oliblarga qanday sovg'a beriladi?",
            "Har oyning 1-, 2- va 3-o'rin egalari kitob sovg'asi bilan taqdirlanadi. Sovg'a kitob g'olibning profilida ko'rsatiladi. Ya'ni ko'proq o'qisangiz — sovg'a kitob yutib olish imkoniyatingiz shuncha yuqori bo'ladi."),
        ("Taqriz va iqtibos qanday joylayman?",
            "Tasmadan taqriz yozib, unga kitob, rasm va baho biriktirasiz. Iqtibos uchun esa kitobdan yoqqan satrni tanlab, chiroyli kartochka ko'rinishida saqlaysiz. Ikkalasiga ham boshqalar yoqtirish bosishi va izoh qoldirishi mumkin."),
        ("Kitoblarimni qanday qo'shaman?",
            "Tasma yoki kutubxona sahifasida kitobni qidiring; agar topilmasa, nom, muallif va muqova bilan yangi kitob qo'shasiz."),
        ("Boshqalar bilan qanday bog'lanaman?",
            "Foydalanuvchilarni qidirib, ularni kuzatasiz va ulanish so'rovi yuborib real vaqtda xabar almashasiz."),
        ("kitobdagimen.uz loyihasini kim yaratgan?",
            "Loyihaning asoschisi va dasturchisi — Javohir Sadullayev. kitobdagimen.uz o'zbek kitobxonlari uchun mustaqil ishlab chiqilgan bepul ijtimoiy platforma."),
    };
    ViewData["JsonLd"] = KitobdaGimen.Web.Seo.SeoJsonLd.Website(seoBase, faq);

    var isAuth = CurrentUser.IsAuthenticated;
    var primaryHref = isAuth ? "/feed" : "/login";
    var primaryLabel = isAuth ? "Tasmaga o'tish" : "Kirish";
}

<div class="lp-shell">
    <div class="lp-header-sticky">
        <header class="lp-nav">
            <a class="brand" href="/">
                <img class="brand-logo" src="~/img/logo.png" alt="kitobdagimen.uz logotipi" />
                <span class="brand-text">kitobdagimen<span class="brand-dot">.uz</span></span>
            </a>
            <nav class="lp-nav-links">
                <a href="#imkoniyatlar">Imkoniyatlar</a>
                <a href="#challenge">Challenge</a>
                <a href="#qanday">Qanday ishlaydi</a>
                <a href="/qollanma">Qo'llanma</a>
                <a href="#savol">Savollar</a>
            </nav>
            <div class="lp-nav-right">
                <button type="button" class="nav-icon-btn" data-theme-toggle title="Kun / Tun rejimi" aria-label="Kun / Tun rejimi">
                    <span class="material-symbols-outlined theme-icon">dark_mode</span>
                </button>
                <a class="btn btn-primary btn-sm" href="@primaryHref">@primaryLabel</a>
            </div>
        </header>
    </div>

    <div class="lp">
        @if (Context.Request.Query.ContainsKey("xato"))
        {
            <div class="lp-alert">Kirishda xatolik yuz berdi. Qaytadan urinib ko'ring.</div>
        }

        <section class="lp-hero">
            <span class="lp-eyebrow">
                <span class="lp-eyebrow-dot"></span>
                O'zbek kitobxonlari uchun ijtimoiy platforma
            </span>
            <h1>
                O'qigan kitoblaringiz bilan <span class="lp-serif-accent">yashaydigan</span> zamonaviy jamiyat
            </h1>
            <p class="lp-sub">
                kitobdagimen.uz — kitob taqrizlarini ulashing, sevimli iqtiboslaringizni
                saqlang, oylik kitobxonlik musobaqasida qatnashib kitob yutib oling va boshqa
                kitobsevarlar bilan suhbatlashing. Hammasi bitta joyda, o'zbek tilida.
            </p>
            <div class="lp-hero-actions">
                @if (isAuth)
                {
                    <a class="btn btn-primary lp-cta-btn" href="/feed">
                        <span class="material-symbols-outlined">dynamic_feed</span>
                        Tasmaga o'tish
                    </a>
                }
                else
                {
                    <a class="btn btn-primary lp-cta-btn" href="/login">
                        <span class="material-symbols-outlined">smart_toy</span>
                        Telegram Bot orqali kirish
                    </a>
                }
                <a class="btn btn-outline lp-secondary-btn" href="#imkoniyatlar">Imkoniyatlarni ko'rish</a>
            </div>
            <p class="lp-terms">
                @if (isAuth)
                {
                    <text>Siz allaqachon tizimdasiz — istalgan vaqtda tasmangizga qayting.</text>
                }
                else
                {
                    <text>Davom etish orqali siz foydalanish shartlariga rozilik bildirasiz</text>
                }
            </p>

            <ul class="lp-trust">
                <li><span class="material-symbols-outlined">verified</span> 100% bepul</li>
                <li><span class="material-symbols-outlined">emoji_events</span> Oylik musobaqa — kitob sovg'a</li>
                <li><span class="material-symbols-outlined">forum</span> Real vaqt suhbat</li>
                <li><span class="material-symbols-outlined">language</span> O'zbek tilida</li>
            </ul>
        </section>

        @* Product Bento Preview *@
        <div class="lp-preview-bento" aria-hidden="true">
            <div class="lp-bento-card">
                <div class="lp-bento-head">
                    <span class="lp-bento-tag"><span class="material-symbols-outlined ic-xs">menu_book</span> Mutolaa maqsadi</span>
                    <span class="muted" style="font-size:12px; font-weight:600">Kunlik: 30 bet</span>
                </div>
                <div class="lp-mock-book">
                    <div class="lp-mock-cover">
                        <span class="material-symbols-outlined">auto_stories</span>
                    </div>
                    <div class="lp-mock-info">
                        <div class="lp-mock-title">O'tkan kunlar</div>
                        <div class="lp-mock-author">Abdulla Qodiriy · 280 / 380 bet</div>
                        <div class="lp-mock-bar"><span></span></div>
                    </div>
                </div>
                <div class="muted" style="font-size:13px; display:flex; align-items:center; justify-content:space-between">
                    <span>74% yakunlandi</span>
                    <span style="color:var(--primary); font-weight:600">+25 bet bugun</span>
                </div>
            </div>

            <div class="lp-bento-card">
                <div class="lp-bento-head">
                    <span class="lp-bento-tag accent"><span class="material-symbols-outlined ic-xs">format_quote</span> Kun iqtibosi</span>
                    <span class="muted" style="font-size:12px">Saqlangan</span>
                </div>
                <blockquote class="lp-mock-quote">
                    “Moziyg'a qaytib ish ko'rish xayrlik, deydilar. Shunga ko'ra mavzuni moziydan, yaqin o'tkan kunlardan belguladik.”
                </blockquote>
                <div class="muted" style="font-size:12.5px; display:flex; align-items:center; justify-content:space-between">
                    <span><strong>Abdulla Qodiriy</strong></span>
                    <span style="display:inline-flex; align-items:center; gap:4px; color:var(--accent); font-weight:600">
                        <span class="material-symbols-outlined ic-xs" style="font-variation-settings:'FILL' 1">favorite</span> 148
                    </span>
                </div>
            </div>

            <div class="lp-bento-card">
                <div class="lp-bento-head">
                    <span class="lp-bento-tag"><span class="material-symbols-outlined ic-xs">emoji_events</span> Oylik Challenge</span>
                    <span class="badge badge-accent" style="font-size:11px">Jonli</span>
                </div>
                <div class="lp-mock-rank-list">
                    <div class="lp-mock-rank">
                        <span class="lp-mock-rank-medal m1">1</span>
                        <span style="flex:1">Dilnoza K.</span>
                        <span style="color:var(--primary)">5 kitob</span>
                    </div>
                    <div class="lp-mock-rank">
                        <span class="lp-mock-rank-medal m2">2</span>
                        <span style="flex:1">Javohir S.</span>
                        <span style="color:var(--primary)">4 kitob</span>
                    </div>
                    <div class="lp-mock-rank">
                        <span class="lp-mock-rank-medal m3">3</span>
                        <span style="flex:1">Malika R.</span>
                        <span style="color:var(--primary)">4 kitob</span>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewData["LandingStats"] is KitobdaGimen.Application.Features.Home.Queries.GetLandingStats.LandingStatsDto stats)
        {
            <section class="lp-section lp-stats" id="statistika" aria-label="Platforma statistikasi">
                <div class="lp-stats-grid">
                    <div class="lp-stat">
                        <span class="lp-stat-icon"><span class="material-symbols-outlined">group</span></span>
                        <div>
                            <span class="lp-stat-num" data-count="@stats.UserCount">@stats.UserCount.ToString("N0")</span>
                            <span class="lp-stat-label">Kitobxonlar</span>
                        </div>
                    </div>
                    <div class="lp-stat">
                        <span class="lp-stat-icon"><span class="material-symbols-outlined">menu_book</span></span>
                        <div>
                            <span class="lp-stat-num" data-count="@stats.BooksRead">@stats.BooksRead.ToString("N0")</span>
                            <span class="lp-stat-label">O'qib tugatilgan kitoblar</span>
                        </div>
                    </div>
                    <div class="lp-stat">
                        <span class="lp-stat-icon"><span class="material-symbols-outlined">auto_stories</span></span>
                        <div>
                            <span class="lp-stat-num" data-count="@stats.PagesRead">@stats.PagesRead.ToString("N0")</span>
                            <span class="lp-stat-label">Jami o'qilgan betlar</span>
                        </div>
                    </div>
                </div>
            </section>
        }

        <section class="lp-section" id="imkoniyatlar">
            <div class="lp-section-head">
                <span class="eyebrow">Imkoniyatlar</span>
                <h2>Platforma imkoniyatlari</h2>
                <p class="muted">Kitobxonlik tajribangizni boyitadigan barcha zamonaviy vositalar — bitta qulay tizimda</p>
            </div>
            <div class="lp-grid">
                <div class="lp-feature">
                    <span class="lp-feature-icon"><span class="material-symbols-outlined">edit_note</span></span>
                    <h3>Taqrizlar</h3>
                    <p>O'qigan kitobingiz haqida taqriz yozing, rasm biriktiring va baho bering. Taqrizlaringizga
                        yoqtirishlar va izohlar orqali jonli munozara boshlang.</p>
                </div>
                <div class="lp-feature">
                    <span class="lp-feature-icon"><span class="material-symbols-outlined">format_quote</span></span>
                    <h3>Iqtiboslar</h3>
                    <p>Kitobdagi eng ta'sirchan satrlarni chiroyli kartochka ko'rinishida saqlang. Iqtiboslarni
                        yoqtiring, izoh qoldiring va do'stlaringizga ulashing.</p>
                </div>
                <div class="lp-feature">
                    <span class="lp-feature-icon"><span class="material-symbols-outlined">emoji_events</span></span>
                    <h3>Challenge — oylik musobaqa</h3>
                    <p>Har oy eng ko'p kitob o'qiganlar musobaqasida qatnashing. 1-, 2- va 3-o'rin
                        egalari kitob sovg'asi bilan taqdirlanadi.</p>
                </div>
                <div class="lp-feature">
                    <span class="lp-feature-icon"><span class="material-symbols-outlined">target</span></span>
                    <h3>O'qish maqsadlari</h3>
                    <p>Kunlik va yillik kitob maqsadingizni belgilang, o'qilgan betlarni kuzating va rivojlanishingizni ko'ring.</p>
                </div>
                <div class="lp-feature">
                    <span class="lp-feature-icon"><span class="material-symbols-outlined">forum</span></span>
                    <h3>Real vaqt xabarlar</h3>
                    <p>Boshqa kitobxonlar bilan jonli suhbatlashing, online holatni ko'ring va tavsiyalar almashing.</p>
                </div>
                <div class="lp-feature">
                    <span class="lp-feature-icon"><span class="material-symbols-outlined">swap_horiz</span></span>
                    <h3>Kitob almashish va Storylar</h3>
                    <p>Jismoniy kitoblarni boshqa kitobxonlar bilan almashing hamda nima o'qiyotganingizni 24 soatlik storylarda ulashing.</p>
                </div>
            </div>
        </section>

        <section class="lp-section lp-showcase-wrap">
            <div class="lp-section-head">
                <span class="eyebrow">Qulaylik</span>
                <h2>Kitobxonlik — endi ijtimoiy tajriba</h2>
                <p class="muted">Har bir o'qilgan kitob jamiyat bilan boyitiladi</p>
            </div>
            <div class="lp-showcase">
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">menu_book</span></span>
                    <div>
                        <h3>Shaxsiy kutubxona</h3>
                        <p>O'qiyotgan va o'qib tugatgan kitoblaringizni tartibga soling. Har bir kitob bo'yicha jarayoningiz avtomatik saqlanadi.</p>
                    </div>
                </article>
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">insights</span></span>
                    <div>
                        <h3>Aqlli tasma</h3>
                        <p>Siz kuzatadigan kitobxonlar va qiziqishlaringizga mos taqrizlar tasmangizda eng yangi tartibida chiqadi.</p>
                    </div>
                </article>
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">notifications_active</span></span>
                    <div>
                        <h3>Jonli bildirishnomalar</h3>
                        <p>Yoqtirishlar, izohlar, yangi obunachilar va xabarlardan real vaqtda xabardor bo'lib turing.</p>
                    </div>
                </article>
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">dark_mode</span></span>
                    <div>
                        <h3>Kun va tun rejimi</h3>
                        <p>Ko'zingizga qulay rejimni tanlang — bir bosishda yorug' kunduzgi yoki qorong'u tungi ko'rinishga o'ting.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="lp-section" id="postlar">
            <div class="lp-section-head">
                <span class="eyebrow">Muloqot</span>
                <h2>Taqrizlar va iqtiboslar bilan yashang</h2>
                <p class="muted">O'qiganlaringizni jamiyat bilan bo'lishing — har bir fikr va satr o'z o'rnini topsin</p>
            </div>
            <div class="lp-showcase">
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">edit_note</span></span>
                    <div>
                        <h3>Taqriz yozing</h3>
                        <p>O'qigan kitobingiz haqida taassurotlaringizni yozing, muqova rasmini biriktiring. Taqrizingiz kuzatuvchilaringiz tasmasida paydo bo'ladi.</p>
                    </div>
                </article>
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">chat_bubble</span></span>
                    <div>
                        <h3>Muhokama qiling</h3>
                        <p>Har bir taqrizga yoqtirish bosing va izoh qoldiring. Yoqqan kitoblar atrofida jonli suhbat va tavsiyalar tug'iladi.</p>
                    </div>
                </article>
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">format_quote</span></span>
                    <div>
                        <h3>Iqtibos saqlang</h3>
                        <p>Kitobdagi eng yoqqan satrni chiroyli iqtibos kartochkasiga aylantiring — muallif va kitob nomi bilan. Shaxsiy iqtiboslar to'plamingizni yig'ing.</p>
                    </div>
                </article>
                <article class="lp-show-card">
                    <span class="lp-show-icon"><span class="material-symbols-outlined">share</span></span>
                    <div>
                        <h3>Ulashing</h3>
                        <p>Yoqqan iqtibos va taqrizlarni do'stlaringizga ulashing. Iqtiboslar qidiruv tizimlarida ham indekslanadi — o'qiganingiz boshqalarga ham yetib boradi.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="lp-section" id="challenge">
            <div class="lp-challenge">
                <div class="lp-section-head">
                    <span class="lp-challenge-badge">
                        <span class="material-symbols-outlined">emoji_events</span>
                        Challenge
                    </span>
                    <h2>Har oy — kitobxonlik musobaqasi</h2>
                    <p class="muted">
                        Har oyning 1-kunidan oxirgi kunigacha eng ko'p kitob o'qigan kitobxonlar bellashadi.
                        Oy yakunida eng zo'r 3 kitobxon g'olib deb e'lon qilinadi va kitob sovg'asi bilan
                        taqdirlanadi. Har kuni o'qiganingizni belgilab boring — yetakchilar reytingi jonli yangilanadi.
                    </p>
                </div>

                <div class="lp-podium">
                    <div class="lp-podium-card">
                        <span class="lp-medal silver">2</span>
                        <h3>2-o'rin</h3>
                        <p>Oyning kumush kitobxoni</p>
                        <span class="lp-prize"><span class="material-symbols-outlined">redeem</span> Sovg'a kitob</span>
                    </div>
                    <div class="lp-podium-card is-first">
                        <span class="lp-medal gold">1</span>
                        <h3>1-o'rin</h3>
                        <p>Oyning eng faol kitobxoni</p>
                        <span class="lp-prize"><span class="material-symbols-outlined">redeem</span> Sovg'a kitob</span>
                    </div>
                    <div class="lp-podium-card">
                        <span class="lp-medal bronze">3</span>
                        <h3>3-o'rin</h3>
                        <p>Oyning bronza kitobxoni</p>
                        <span class="lp-prize"><span class="material-symbols-outlined">redeem</span> Sovg'a kitob</span>
                    </div>
                </div>

                <ul class="lp-challenge-rules">
                    <li><span class="material-symbols-outlined">calendar_month</span> Har oy yangi davr — 1-kundan oxirgi kungacha</li>
                    <li><span class="material-symbols-outlined">trending_up</span> Jonli reyting — yetakchilarni real vaqtda kuzating</li>
                    <li><span class="material-symbols-outlined">workspace_premium</span> Oy oxirida g'oliblar tantanali e'lon qilinadi</li>
                    <li><span class="material-symbols-outlined">redeem</span> 1-, 2- va 3-o'rin uchun kitob sovg'asi</li>
                </ul>
            </div>
        </section>

        <section class="lp-section" id="qanday">
            <div class="lp-steps">
                <div class="lp-section-head">
                    <span class="eyebrow">Boshlash</span>
                    <h2>Qanday boshlash mumkin</h2>
                    <p class="muted">Uch oddiy qadamda jamiyatga qo'shiling</p>
                </div>
                <div class="lp-grid lp-grid-3">
                    <div class="lp-step">
                        <span class="lp-step-num">1</span>
                        <h3>Telegram Bot orqali kiring</h3>
                        <p>@@KitobdagiMenBot da ism-familiya va username kiritib, 2 daqiqalik kod orqali kiring.</p>
                    </div>
                    <div class="lp-step">
                        <span class="lp-step-num">2</span>
                        <h3>Qiziqishlaringizni tanlang</h3>
                        <p>Yoqtirgan janrlaringizni belgilang, biz sizga mos kontentni ko'rsatamiz.</p>
                    </div>
                    <div class="lp-step">
                        <span class="lp-step-num">3</span>
                        <h3>Ulashishni boshlang</h3>
                        <p>Fikr yozing, maqsad qo'ying va kitobxonlar bilan tanishing.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="lp-section" id="savol">
            <div class="lp-section-head">
                <span class="eyebrow">FAQ</span>
                <h2>Ko'p so'raladigan savollar</h2>
                <p class="muted">Boshlashdan oldin bilishingiz kerak bo'lgan narsalar</p>
            </div>
            <div class="lp-faq">
                @foreach (var qa in faq)
                {
                    <details class="lp-faq-item">
                        <summary>@qa.Question</summary>
                        <p>@qa.Answer</p>
                    </details>
                }
            </div>
        </section>

        <section class="lp-section lp-guide-promo">
            <div class="lp-guide-promo-inner">
                <span class="lp-guide-promo-icon"><span class="material-symbols-outlined">menu_book</span></span>
                <div class="lp-guide-promo-text">
                    <h2>Dasturdan foydalanish qo'llanmasi</h2>
                    <p>
                        Birinchi marta kiryapsizmi? Kirishdan tortib post yozish, kitob qo'shish,
                        o'qish maqsadi belgilash, iqtibos saqlash, story joylash va kitobxonlar bilan
                        real vaqtda suhbatlashishgacha — har bir imkoniyatni bosqichma-bosqich
                        tushuntiruvchi to'liq qo'llanmani o'qib chiqing.
                    </p>
                </div>
                <a class="btn btn-outline lp-cta-btn" href="/qollanma">
                    <span class="material-symbols-outlined">auto_stories</span>
                    To'liq qo'llanmani o'qish
                </a>
            </div>
        </section>

        <section class="lp-cta">
            <h2>Bugun o'qish sayohatingizni boshlang</h2>
            <p>Post yozing, iqtibos saqlang va oylik musobaqada kitob yutib oling — hammasi bepul.</p>
            <a class="btn btn-accent lp-cta-btn-lg" href="@primaryHref">
                @if (isAuth)
                {
                    <text>Tasmaga o'tish</text>
                }
                else
                {
                    <text>Bepul qo'shilish</text>
                }
            </a>
        </section>

        <footer class="lp-footer">
            <div class="lp-footer-brand">
                <div class="brand">
                    <img class="brand-logo" src="~/img/logo.png" alt="" />
                    <span class="brand-text">kitobdagimen<span class="brand-dot">.uz</span></span>
